			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776760569870</Id>
					<Name><![CDATA[initLoadSite]]></Name>
					<X>460</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[id]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[name]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[oreFlag]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[g]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[remain]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[svcTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[xPos]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[yPos]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[bucket1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[density1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[siteId = id;
siteName = name;
isOre = oreFlag;
grade = g;
remainingTons = remain;
initialReserveTons = remain;
producedMetalTons = 0.0;
singleServeTime = svcTime;
bucket = bucket1;
density = density1;

available = true;
incomingTrucks = 0;
busy = false;
this.xPos = xPos;
this.yPos = yPos;
producedTons = 0.0;
totalServiceTime = 0.0;

reservedTons = 0.0;
extractionCursorTons = 0.0;
numInService = 0;
totalQueueTime = 0.0;
totalServed = 0;
shovelCapacity = 1;
shovelResource.set_capacity(shovelCapacity);
delay.set_capacity(shovelCapacity);

if (gradeBlockTons <= 0.0 || remain < 0.0 || gradeHalfRange < 0.0) {
    throw new IllegalArgumentException("Invalid material block or reserve");
}
int blockCount = Math.max(1, (int)Math.ceil(remain / gradeBlockTons));
blockGrades = new double[blockCount];
java.util.Random gradeRng = new java.util.Random(
    main.experimentSeed ^ (0x9E3779B97F4A7C15L * (id + 1L))
);
for (int i = 0; i < blockCount; i++) {
    double delta = main.deterministicCheck ? 0.0
        : (2.0 * gradeRng.nextDouble() - 1.0) * gradeHalfRange;
    blockGrades[i] = isOre ? Math.max(0.0, Math.min(1.0, grade + delta)) : 0.0;
}
shovelIdleNow = true;
shovelIdleStartSec = 0.0;
shovelIdleAccumSec = 0.0;
obsKnownGrades.clear();
obsLastKnownBlock = -1;
obsLastKnownGrade = 0.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783904060972</Id>
					<Name><![CDATA[getQueueSize]]></Name>
					<X>610</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return queueLoad.size() + seize.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783904090403</Id>
					<Name><![CDATA[getServiceSize]]></Name>
					<X>610</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return delay.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783904114046</Id>
					<Name><![CDATA[getOccupiedSize]]></Name>
					<X>610</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return queueLoad.size() + seize.size() + numInService;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783909713514</Id>
					<Name><![CDATA[function]]></Name>
					<X>610</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783930437455</Id>
					<Name><![CDATA[function1]]></Name>
					<X>610</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406524935</Id>
					<Name><![CDATA[getUtilization]]></Name>
					<X>750</X><Y>440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return numInService > 0 ? 1.0 : 0.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792413191502</Id>
					<Name><![CDATA[loadServiceMinutes]]></Name>
					<X>810</X><Y>110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[double tonsPerBucket = Math.min(30.0, bucket * density * 0.90);
if (t == null || !Double.isFinite(t.plannedPayloadTons)
    || t.plannedPayloadTons <= 0.0 || tonsPerBucket <= 0.0) {
    throw new IllegalStateException("Invalid loading task at " + siteName);
}
int n = (int)Math.ceil((t.plannedPayloadTons - 1e-9) / tonsPerBucket);
if (n < 1) throw new IllegalStateException("Invalid bucket count");
double meanServiceTime = 0.70 + singleServeTime * n;
double factor = main.deterministicCheck ? 1.0 : triangular(0.9, 1.0, 1.1);
return meanServiceTime * factor;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792418622858</Id>
					<Name><![CDATA[getAvailableTons]]></Name>
					<X>1020</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!available) return 0.0;
return Math.max(0.0, remainingTons - reservedTons);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792418694847</Id>
					<Name><![CDATA[reserveLoad]]></Name>
					<X>1020</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null
    || t.isLoaded
    || t.plannedPayloadTons > 1e-6
    || t.incomingLoadSiteId != -1
    || !Double.isFinite(t.capacity)
    || t.capacity <= 0.0) {

    throw new IllegalArgumentException(
        "Invalid reservation request at " + siteName
    );
}

double tons = Math.min(t.capacity, getAvailableTons());

if (tons <= 1e-6) {
    throw new IllegalStateException(
        "No unreserved material at " + siteName
    );
}

reservedTons += tons;
incomingTrucks++;

return tons;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792418724047</Id>
					<Name><![CDATA[registerArrival]]></Name>
					<X>1030</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null || t.targetShovel != this || t.incomingLoadSiteId != siteId
    || incomingTrucks <= 0) {
    throw new IllegalStateException("Incoming truck mismatch at " + siteName);
}
incomingTrucks--;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792418738945</Id>
					<Name><![CDATA[completeLoading]]></Name>
					<X>1030</X><Y>160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null || t.targetShovel != this || t.isLoaded) {
    throw new IllegalStateException("Invalid loading completion at " + siteName);
}
double tons = t.plannedPayloadTons;
if (!Double.isFinite(tons) || tons <= 0.0
    || tons > remainingTons + 1e-6 || tons > reservedTons + 1e-6) {
    throw new IllegalStateException("Source balance mismatch at " + siteName);
}
if (!Double.isFinite(t.payloadGrade) || t.payloadGrade < 0.0 || t.payloadGrade > 1.0
    || (!isOre && Math.abs(t.payloadGrade) > 1e-12)) {
    throw new IllegalStateException("Invalid loaded grade at " + siteName);
}
remainingTons = Math.max(0.0, remainingTons - tons);
obsRecordCompletedGrade(t, tons);
reservedTons = Math.max(0.0, reservedTons - tons);
producedTons += tons;
if (isOre) producedMetalTons += tons * t.payloadGrade;
busy = false;
return tons;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792418768235</Id>
					<Name><![CDATA[takeMaterialGrade]]></Name>
					<X>1020</X><Y>190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(tons) || tons <= 0.0) {
    throw new IllegalArgumentException("Invalid load tons: " + tons);
}
double initialTons = remainingTons + producedTons;
double end = extractionCursorTons + tons;
if (end > initialTons + 1e-6) {
    throw new IllegalStateException("Material cursor exceeds reserve at " + siteName);
}
double cursor = extractionCursorTons;
double metal = 0.0;
while (cursor < end - 1e-9) {
    int index = (int)Math.floor(cursor / gradeBlockTons);
    if (index < 0 || index >= blockGrades.length) {
        throw new IllegalStateException("Invalid material block at " + siteName);
    }
    double stop = Math.min(end, (index + 1.0) * gradeBlockTons);
    metal += (stop - cursor) * blockGrades[index];
    cursor = stop;
}
extractionCursorTons = end;
return metal / tons;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792496913993</Id>
					<Name><![CDATA[auditSourceBalance]]></Name>
					<X>1020</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[where]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String p = where + " source=" + siteName;
main.auditRequire(Double.isFinite(initialReserveTons) && initialReserveTons >= 0.0,
    p + " invalid initialReserveTons");
main.auditRequire(Double.isFinite(remainingTons) && remainingTons >= -1e-6,
    p + " invalid remainingTons=" + remainingTons);
main.auditRequire(Double.isFinite(producedTons) && producedTons >= -1e-6,
    p + " invalid producedTons=" + producedTons);
main.auditRequire(Double.isFinite(reservedTons) && reservedTons >= -1e-6
    && reservedTons <= remainingTons + 1e-6,
    p + " invalid reservedTons=" + reservedTons);
main.auditClose(p + " initial=remaining+mined",
    initialReserveTons, remainingTons + producedTons);

double truckReservations = 0.0;
for (Truck t : main.trucks) {
    if (t.targetShovel == this) truckReservations += t.plannedPayloadTons;
}
main.auditClose(p + " reservations=assigned-trucks", reservedTons, truckReservations);
main.auditRequire(Double.isFinite(producedMetalTons)
    && producedMetalTons >= -1e-6 && producedMetalTons <= producedTons + 1e-6,
    p + " invalid producedMetalTons=" + producedMetalTons);
if (!isOre) main.auditClose(p + " waste-metal=0", producedMetalTons, 0.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792500227316</Id>
					<Name><![CDATA[setShovelIdle]]></Name>
					<X>370</X><Y>-60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idle]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[double nowSec = Math.max(
    0.0,
    Math.min(time(SECOND), main.rlShiftSeconds)
);

if (idle == shovelIdleNow) return;

if (shovelIdleNow) {
    shovelIdleAccumSec += Math.max(
        0.0,
        nowSec - shovelIdleStartSec
    );
}

shovelIdleNow = idle;
shovelIdleStartSec = nowSec;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792500246554</Id>
					<Name><![CDATA[getShovelIdleSeconds]]></Name>
					<X>400</X><Y>-30</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double nowSec = Math.max(
    0.0,
    Math.min(time(SECOND), main.rlShiftSeconds)
);

return shovelIdleAccumSec
    + (shovelIdleNow
        ? Math.max(0.0, nowSec - shovelIdleStartSec)
        : 0.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578382301</Id>
					<Name><![CDATA[obsMeanLoadMinutes]]></Name>
					<X>1250</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double perBucket=Math.min(30.0,bucket*density*0.90);
if(!Double.isFinite(tons) || tons<=0.0 || perBucket<=0.0)
    throw new IllegalArgumentException("Invalid observed loading task");
int n=(int)Math.ceil((tons-1e-9)/perBucket);
return 0.70+singleServeTime*n;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578421761</Id>
					<Name><![CDATA[obsRecordCompletedGrade]]></Name>
					<X>1250</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if(!isOre || main.deterministicCheck) return;
double start=t.obsLoadMaterialStart, end=start+tons;
if(tons<=0 || tons>=gradeBlockTons || Math.abs(start-producedTons)>1e-5)
    throw new IllegalStateException("Grade observation order mismatch at "+siteName);
// 判断本次已完成装载是否完全位于同一个品位块。
// 1e-9 仅用于处理块边界的浮点舍入。
int firstBlock = (int) Math.floor(
    (start + 1e-9) / gradeBlockTons
);
int lastBlock = (int) Math.floor(
    (end - 1e-9) / gradeBlockTons
);

if (firstBlock == lastBlock) {
    double measuredGrade = t.payloadGrade;

    if (!Double.isFinite(measuredGrade)
        || measuredGrade
            < Math.max(0.0, grade - gradeHalfRange) - 1e-6
        || measuredGrade
            > Math.min(1.0, grade + gradeHalfRange) + 1e-6) {

        throw new IllegalStateException(
            "Invalid completed grade measurement at " + siteName
        );
    }

    // 纯块整车的已完成测量，直接更新该块的已知品位。
    obsKnownGrades.put(firstBlock, measuredGrade);
    obsLastKnownBlock = firstBlock;
    obsLastKnownGrade = measuredGrade;
    return;
}
double knownMetal=0.0, unknownTons=0.0;
int unknownBlock=-1;
for(double cursor=start;cursor<end-1e-9;) {
    int k=(int)Math.floor(cursor/gradeBlockTons);
    double stop=Math.min(end,(k+1.0)*gradeBlockTons);
    Double known=obsKnownGrades.get(k);
    if(known!=null) knownMetal+=(stop-cursor)*known;
    else {
        if(unknownBlock>=0 && unknownBlock!=k)
            throw new IllegalStateException("More than one unknown grade block: "+siteName);
        unknownBlock=k;
        unknownTons+=stop-cursor;
    }
    cursor=stop;
}
if(unknownBlock>=0) {
    double measured=(tons*t.payloadGrade-knownMetal)/unknownTons;
    if(!Double.isFinite(measured) || measured<Math.max(0.0,grade-gradeHalfRange)-1e-6
        || measured>Math.min(1.0,grade+gradeHalfRange)+1e-6)
        throw new IllegalStateException("Inconsistent completed grade measurement: "+siteName);
    obsKnownGrades.put(unknownBlock,measured);
    obsLastKnownBlock=unknownBlock;
    obsLastKnownGrade=measured;
} else if (Math.abs(tons * t.payloadGrade - knownMetal) > 1e-5) {
    double actualMetal = tons * t.payloadGrade;

    throw new IllegalStateException(
        "Known grade mass mismatch at " + siteName
        + " truck=" + t.truckId
        + " start=" + start
        + " end=" + end
        + " produced=" + producedTons
        + " cursor=" + extractionCursorTons
        + " tons=" + tons
        + " truckGrade=" + t.payloadGrade
        + " expectedGrade=" + (knownMetal / tons)
        + " actualMetal=" + actualMetal
        + " knownMetal=" + knownMetal
        + " error=" + (actualMetal - knownMetal)
        + " knownGrades=" + obsKnownGrades
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1792578450946</Id>
					<Name><![CDATA[obsGradeStats]]></Name>
					<X>1250</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[start]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if(tons<=0.0) return new double[]{0.0,0.0,0.0};
if(!isOre || main.deterministicCheck) return new double[]{isOre?grade:0.0,0.0,1.0};
double end=start+tons, metalMean=0.0, metalVariance=0.0;
boolean allKnown=true;
for(double cursor=start;cursor<end-1e-9;) {
    int k=(int)Math.floor(cursor/gradeBlockTons);
    double stop=Math.min(end,(k+1.0)*gradeBlockTons), q=stop-cursor;
    Double known=obsKnownGrades.get(k);
    if(known!=null) metalMean+=q*known;
    else {
        // Current ore means are well inside [0,1], so no clipping mass occurs.
        if(grade-gradeHalfRange<0 || grade+gradeHalfRange>1)
            throw new IllegalStateException("Re-derive grade prior after changing bounds");
        metalMean+=q*grade;
        metalVariance+=q*q*gradeHalfRange*gradeHalfRange/3.0;
        allKnown=false;
    }
    cursor=stop;
}
return new double[]{metalMean/tons,Math.sqrt(metalVariance)/tons,allKnown?1.0:0.0};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578495568</Id>
					<Name><![CDATA[appendDispatchObservation]]></Name>
					<X>1250</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[w]]></Name>
						<Type><![CDATA[DispatchObsWriter]]></Type>
					</Parameter>
					<Body><![CDATA[String p="load."+siteId+".";
w.add(p+"available",available?1:0);
w.add(p+"isOre",isOre?1:0);
w.add(p+"meanGrade",grade);
w.add(p+"gradeHalfRange",main.deterministicCheck?0:gradeHalfRange);
w.add(p+"initialTons",initialReserveTons/30000.0);
w.add(p+"remainingTons",remainingTons/30000.0);
w.add(p+"reservedTons",reservedTons/30000.0);
w.add(p+"availableTons",getAvailableTons()/30000.0);
w.add(p+"producedTons",producedTons/30000.0);
w.add(p+"allocationCursor",extractionCursorTons/30000.0);
w.add(p+"blockTons",gradeBlockTons/500.0);
double inBlock=extractionCursorTons-Math.floor(extractionCursorTons/gradeBlockTons)*gradeBlockTons;
w.add(p+"cursorFraction",inBlock/gradeBlockTons);
w.add(p+"lastKnownBlock",obsLastKnownBlock<0?0:(obsLastKnownBlock+1.0)/60.0);
w.add(p+"lastKnownGrade",obsLastKnownBlock<0?0:obsLastKnownGrade);
w.add(p+"shovelCapacity",shovelCapacity);
w.add(p+"shovelBusy",shovelResource.busy());
w.add(p+"loadingCount",numInService);
w.add(p+"incomingCount",incomingTrucks/9.0);
w.add(p+"bucketTons",Math.min(30.0,bucket*density*0.90)/30.0);
w.add(p+"singleServeMin",singleServeTime);
java.util.ArrayList<Truck> q=new java.util.ArrayList<Truck>();
for(int i=0;i<queueLoad.size();i++) q.add((Truck)queueLoad.get(i));
w.truckSlots(p+"queue.",q);
q.clear();
for(int i=0;i<seize.size();i++) q.add((Truck)seize.get(i));
w.truckSlots(p+"seize.",q);
q.clear();
for(int i=0;i<delay.size();i++) q.add((Truck)delay.get(i));
java.util.Collections.sort(q,(a,b)->Integer.compare(a.truckId,b.truckId));
w.truckSlots(p+"service.",q);]]></Body>
				</Function>
			</Functions>
