					<Action><![CDATA[remainingDistanceOnSegment = this.calculateDisOnSeg();
remainingDistanceToDestination = this.calculateDisToDes();
traceln("到下一个节点："+ targetNodeName+ "距离是："+  remainingDistanceOnSegment);
