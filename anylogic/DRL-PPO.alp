						<Action><![CDATA[hasEnteredCurrentProcess = true;
executionPhase = "WAITING_DUMP";

if (currentLegToSiteId != null && !currentLegToSiteId.isBlank()) {
    currentBusinessSiteId = currentLegToSiteId;
}

double beforeX = getX();
double beforeY = getY();

traceln(
    "[ENTER_DUMP_BEFORE] truck=" + truckId
    + ", pos=(" + beforeX + "," + beforeY + ")"
    + ", site=" + targetDump.siteName
);
arrivalTime = time();

currentTravelTime =
    Math.max(0, arrivalTime - legTravelStartTime);

if (!main.isWarmUp) {
    main.totalTravelTime += currentTravelTime;
}
targetDump.enterDump.take(this);

double realizedTravelSec =
    time(SECOND) - legStartSec;

traceln(
