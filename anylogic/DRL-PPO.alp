							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;

if (dumpCapacityWaitOrder.contains(t)) {
    throw new IllegalStateException(
        "Duplicate dump-capacity waiting truck=" + t.truckId
    );
}

dumpCapacityWaitOrder.add(t);

tryAdmitDumpTruck();]]></Code>
