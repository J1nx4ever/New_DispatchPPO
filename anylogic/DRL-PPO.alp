						<Action><![CDATA[currentSegmentIndex++;
//segmentProgress = 0;
if (currentSegmentIndex >= currentRouteSegments.size()) {
    traceln("No next segment, but destination not reached. Check route data.");
    return;
}

currentSegment = currentRouteSegments.get(currentSegmentIndex);
targetNodeName = currentSegment.to;
laneEntrySeq = main.nextLaneEntrySeq++;
targetNodeId = main.destinationToInt(main.getRoadPointNode(targetNodeName));
//remainingDistanceOnSegment = currentSegment.length;
//remainingDistanceToDestination = calculateRemainingDistanceToDestination();

// 如果你维护路段车辆数，这里可以增加
//currentSegment.truckCountOnSegment++;

traceln("Truck " +truckId+ " next segment: "
    + currentSegment.from + " -> " + currentSegment.to);]]></Action>
