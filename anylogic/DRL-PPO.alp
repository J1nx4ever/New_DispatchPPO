					<Name><![CDATA[initDynamicSpeedModel]]></Name>
					<X>2910</X><Y>-600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[emptyBaseSpeedMps.clear();
loadedBaseSpeedMps.clear();
setPhysicalBaseSpeed("Crusher", "intersection1", 26.0, 20.0);
setPhysicalBaseSpeed("intersection1", "intersection2", 26.0, 20.0);
setPhysicalBaseSpeed("intersection2", "intersection3", 26.0, 20.0);
setPhysicalBaseSpeed("intersection3", "ShovelOreHigh2", 23.4, 18.0);
setPhysicalBaseSpeed("intersection2", "ShovelOreHigh1", 23.4, 18.0);
setPhysicalBaseSpeed("intersection3", "ShovelOreLow", 23.4, 18.0);
setPhysicalBaseSpeed("intersection2", "ShovelWaste", 23.4, 18.0);
setPhysicalBaseSpeed("dumpNode", "intersection2", 23.4, 18.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789529408509</Id>
					<Name><![CDATA[getBaseSpeedMps]]></Name>
					<X>2910</X><Y>-570</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[segment]]></Name>
						<Type><![CDATA[PathSegment]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[loaded]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[if (segment == null) {
    return 0;
}

HashMap<String, Double> table =
    loaded ? loadedBaseSpeedMps : emptyBaseSpeedMps;

Double value = table.get(segment.key);

if (value != null && value > 0) {
    return value;
}

// 缺少配置时使用确定性默认值
return loaded ? 15.0 / 3.6 : 25.0 / 3.6;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789540270484</Id>
					<Name><![CDATA[applyDynamicSpeed]]></Name>
					<X>2910</X><Y>-540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[useEndogenousCongestion]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[if (!useLocalDynamicSpeed
    || t == null
    || t.currentSegment == null) {
    return;
}

if (!"TO_LOAD".equals(t.executionPhase)
    && !"TO_DUMP".equals(t.executionPhase)) {
    return;
}


// =====================================================
// 0. 公共参数检查
// 两个实验环境共同使用相同的速度响应参数
// =====================================================

double dt = speedDtSec;

if (!Double.isFinite(dt) || dt <= 0.0) {
    return;
}

if (!Double.isFinite(speedTauSec)
    || speedTauSec <= 1e-6) {
    return;
}

if (!Double.isFinite(maxAccelMps2)
    || maxAccelMps2 < 0.0) {
    return;
}

if (!Double.isFinite(maxDecelMps2)
    || maxDecelMps2 < 0.0) {
    return;
}

if (!Double.isFinite(maxJerkMps3)
    || maxJerkMps3 < 0.0) {
    return;
}

/*
 * 跟驰参数只在启用内生拥堵时使用。
 * 因此外生环境不会因为跟驰参数配置问题而停止速度更新。
 */
if (useEndogenousCongestion) {

    if (!Double.isFinite(criticalGapM)
        || criticalGapM < 0.0) {
        return;
    }

    if (!Double.isFinite(safeGapM)
        || safeGapM <= criticalGapM) {
        return;
    }

    if (!Double.isFinite(followRangeM)
        || followRangeM <= safeGapM) {
        return;
    }

    if (!Double.isFinite(followTauSec)
        || followTauSec <= 1e-6) {
        return;
    }

    if (!Double.isFinite(brakeTauSec)
        || brakeTauSec <= 1e-6) {
        return;
    }

    if (!Double.isFinite(followSpeedMarginMps)
        || followSpeedMarginMps < 0.0) {
        return;
    }
}


// =====================================================
// 1. 当前速度
// =====================================================

double currentSpeed;

try {
    currentSpeed = t.getSpeed();
} catch (Exception e) {
    currentSpeed = t.egoSpeed;
}

if (!Double.isFinite(currentSpeed)
    || currentSpeed < 0.0) {
    currentSpeed = 0.0;
}


// =====================================================
// 2. 统一的自由速度模型
//
// baseSpeed：区分空载、重载以及不同路段
// freeSpeedFactor：车辆初始化时生成的小扰动
//
// 该自由速度在两个实验环境中完全相同。
// =====================================================

double baseSpeed = getBaseSpeedMps(t.currentSegment, t.isLoaded);
double vehicleKph = t.isLoaded
    ? (t.truckType == 0 ? 20.0 : t.truckType == 1 ? 18.0 : 16.0)
    : (t.truckType == 0 ? 26.0 : t.truckType == 1 ? 24.0 : 22.0);
baseSpeed *= vehicleKph / (t.isLoaded ? 20.0 : 26.0);

if (!Double.isFinite(baseSpeed)
    || baseSpeed <= 0.0) {
    return;
}

double freeSpeedFactor =
    t.isLoaded
    ? t.loadedFreeSpeedFactor
    : t.emptyFreeSpeedFactor;

if (!Double.isFinite(freeSpeedFactor)
    || freeSpeedFactor <= 0.0) {
    freeSpeedFactor = 1.0;
}

double freeSpeed = Math.min(t.currentSegment.speedLimit, baseSpeed * freeSpeedFactor);

if (!Double.isFinite(freeSpeed)
    || freeSpeed <= 0.0) {
    freeSpeed = baseSpeed;
}


// =====================================================
// 3. 默认状态：外生运输环境
//
// 只使用“空载/重载基础速度 × 小扰动”，
// 完全忽略车辆之间的距离和速度。
// =====================================================

double desiredSpeed = freeSpeed;
double responseTau = speedTauSec;

t.speedRegime = "FREE";


// =====================================================
// 4. 车辆交互开关
//
// false：外生环境，只使用自由速度
// true ：内生环境，在同一个自由速度上叠加跟驰/制动
// =====================================================

double gap = t.frontDis;
double frontSpeed = 0.0;

boolean validFront =
    useEndogenousCongestion
    && t.hasFront
    && Double.isFinite(gap)
    && gap >= 0.0;

if (validFront) {

    frontSpeed = t.frontSpeed;

    if (!Double.isFinite(frontSpeed)
        || frontSpeed < 0.0) {
        frontSpeed = 0.0;
    }

    t.minGapThisLeg =
        Math.min(t.minGapThisLeg, gap);


    // -------------------------------------------------
    // 4.1 自由流：前车在交互范围之外
    // -------------------------------------------------

    if (gap >= followRangeM) {

        t.speedRegime = "FREE";
        responseTau = speedTauSec;
        desiredSpeed = freeSpeed;
    }


    // -------------------------------------------------
    // 4.2 跟驰流：safeGapM <= gap < followRangeM
    // -------------------------------------------------

    else if (gap >= safeGapM) {

        t.speedRegime = "FOLLOW";
        responseTau = followTauSec;

        double z =
            (gap - safeGapM)
            / (followRangeM - safeGapM);

        z = Math.max(
            0.0,
            Math.min(1.0, z)
        );

        // 三次平滑插值，避免在状态边界速度突变
        double smooth =
            z * z * (3.0 - 2.0 * z);

        double closeFollowSpeed =
            Math.min(
                freeSpeed,
                Math.max(
                    0.0,
                    frontSpeed - followSpeedMarginMps
                )
            );

        desiredSpeed =
            closeFollowSpeed
            + (freeSpeed - closeFollowSpeed) * smooth;

        /*
         * 跟驰状态下目标速度不得高于前车速度，
         * 防止后车在交互区间内持续缩短车距。
         */
        desiredSpeed =
            Math.min(desiredSpeed, frontSpeed);
    }


    // -------------------------------------------------
    // 4.3 制动流：gap < safeGapM
    // -------------------------------------------------

    else {

        t.speedRegime = "BRAKE";
        responseTau = brakeTauSec;

        double followSpeed =
            Math.min(
                freeSpeed,
                Math.max(
                    0.0,
                    frontSpeed - followSpeedMarginMps
                )
            );

        /*
         * gap = safeGapM 时 q = 1；
         * gap <= criticalGapM 时 q = 0。
         */
        double q =
            (gap - criticalGapM)
            / (safeGapM - criticalGapM);

        q = Math.max(
            0.0,
            Math.min(1.0, q)
        );

        double brakeFactor =
            q * q * (3.0 - 2.0 * q);

        desiredSpeed =
            followSpeed * brakeFactor;
    }
}


// =====================================================
// 5. 目标速度限制
// =====================================================

desiredSpeed =
    Math.max(
        0.0,
        Math.min(freeSpeed, desiredSpeed)
    );

if (!Double.isFinite(desiredSpeed)) {
    desiredSpeed = freeSpeed;
}


// =====================================================
// 6. 两个环境共用相同的一阶速度响应
// =====================================================

double rawAccel =
    (desiredSpeed - currentSpeed)
    / responseTau;

if (!Double.isFinite(rawAccel)) {
    rawAccel = 0.0;
}


// =====================================================
// 7. 内生拥堵环境的安全减速
// =====================================================

if (validFront && gap < safeGapM) {

    double severity =
        (safeGapM - gap)
        / (safeGapM - criticalGapM);

    severity =
        Math.max(
            0.0,
            Math.min(1.0, severity)
        );

    double safetyDecel =
        -0.3
        - (maxDecelMps2 - 0.3) * severity;

    rawAccel =
        Math.min(rawAccel, safetyDecel);
}


// =====================================================
// 8. 加速度限制
// =====================================================

rawAccel =
    Math.max(
        -maxDecelMps2,
        Math.min(
            maxAccelMps2,
            rawAccel
        )
    );


// =====================================================
// 9. Jerk 限制
// 两个环境使用相同的速度平滑机制
// =====================================================

if (!Double.isFinite(t.dynamicAccel)) {
    t.dynamicAccel = 0.0;
}

double maxAccelChange =
    maxJerkMps3 * dt;

if (!Double.isFinite(maxAccelChange)
    || maxAccelChange < 0.0) {
    maxAccelChange = 0.0;
}

double lowerAccel =
    t.dynamicAccel - maxAccelChange;

double upperAccel =
    t.dynamicAccel + maxAccelChange;

double appliedAccel =
    Math.max(
        lowerAccel,
        Math.min(
            upperAccel,
            rawAccel
        )
    );

if (!Double.isFinite(appliedAccel)) {
    appliedAccel = 0.0;
}


// =====================================================
// 10. 更新速度
// =====================================================

double newSpeed =
    currentSpeed
    + appliedAccel * dt;


// =====================================================
// 11. 内生拥堵环境的最终安全约束
// =====================================================

if (validFront && gap < safeGapM) {

    double remainingGap =
        Math.max(
            0.0,
            gap - criticalGapM
        );

    double safetySpeedCeiling =
        frontSpeed + remainingGap / dt;

    newSpeed =
        Math.min(
            newSpeed,
            Math.max(0.01, safetySpeedCeiling)
        );
}

if (!Double.isFinite(newSpeed)) {
    return;
}


// =====================================================
// 12. 最终速度范围
//
// 当前速度若暂时高于自由速度，允许平滑下降，
// 避免强制截断导致速度跳变。
// =====================================================

double minMovingSpeedMps =
    validFront && gap < safeGapM
    ? 0.01
    : 0.1;

double upperSpeedMps =
    Math.max(currentSpeed, freeSpeed);

newSpeed =
    Math.max(
        minMovingSpeedMps,
        Math.min(newSpeed, upperSpeedMps)
    );

if (!Double.isFinite(newSpeed)) {
    return;
}


// =====================================================
// 13. 更新 Truck 动态状态
// =====================================================

t.dynamicAccel = appliedAccel;
t.dynamicTargetSpeed = desiredSpeed;
t.segmentBaseSpeed = baseSpeed;
t.freeSpeed = freeSpeed;
t.egoSpeed = newSpeed;


// =====================================================
// 14. 唯一速度应用出口
// =====================================================

try {

    t.setSpeed(newSpeed, MPS);

} catch (Exception e) {

    traceln(
        "[Speed] setSpeed failed"
        + ", truck=" + t.truckId
        + ", time=" + time()
        + ", endogenous=" + useEndogenousCongestion
        + ", segment=" + t.currentSegment
        + ", phase=" + t.executionPhase
        + ", loaded=" + t.isLoaded
        + ", newSpeed=" + newSpeed
        + ", currentSpeed=" + currentSpeed
        + ", desiredSpeed=" + desiredSpeed
        + ", baseSpeed=" + baseSpeed
        + ", freeSpeedFactor=" + freeSpeedFactor
        + ", freeSpeed=" + freeSpeed
        + ", gap=" + gap
        + ", frontSpeed=" + frontSpeed
        + ", appliedAccel=" + appliedAccel
        + ", err=" + e.getMessage()
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789540423751</Id>
					<Name><![CDATA[updateNextSegmentFrontVehicles]]></Name>
					<X>1780</X><Y>-850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (Truck ego : trucks) {

    if (ego == null
        || ego.currentSegment == null
        || ego.hasFront
        || ego.disToInt > followRangeM) {
        continue;
    }

    int index = getCurrentSegmentIndex(ego);

    if (index < 0
        || ego.currentRouteSegments == null
        || index + 1 >= ego.currentRouteSegments.size()) {
        continue;
    }

    PathSegment nextSegment =
        ego.currentRouteSegments.get(index + 1);

    Truck nearest = null;
    double nearestProgress = Double.POSITIVE_INFINITY;

    for (Truck other : trucks) {

        if (other == ego || other.currentSegment == null) {
            continue;
        }

        if (!nextSegment.isSameDirectedSegment(other.currentSegment)) {
            continue;
        }

        double progress =
            nextSegment.calcProgressFromRemainingDistance(
                other.disToInt
            );

        if (progress < nearestProgress) {
            nearestProgress = progress;
            nearest = other;
        }
    }

    if (nearest != null) {
		double dx =
		    nearest.getX() - ego.getX();
		
		double dy =
		    nearest.getY() - ego.getY();
		
		double gap = toLengthUnits(
		    Math.sqrt(dx * dx + dy * dy),
		    METER
		);
		
		if (!Double.isFinite(gap)) {
		    continue;
		}

        if (gap <= followRangeM) {
            ego.hasFront = true;
            ego.front_id = nearest.truckId;
            ego.frontSpeed = nearest.egoSpeed;
            ego.frontDis = gap;

            double closingSpeed =
                ego.egoSpeed - nearest.egoSpeed;

            ego.frontTtc =
                closingSpeed > 0.1
                ? gap / closingSpeed
                : 9999;
        }
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789643896796</Id>
					<Name><![CDATA[sampleTruncatedNormalFactor]]></Name>
					<X>2910</X><Y>-510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[mean]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[std]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lower]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[upper]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(mean)
    || !Double.isFinite(std)
    || !Double.isFinite(lower)
    || !Double.isFinite(upper)
    || std <= 0
    || lower >= upper) {

    return 1.0;
}

// 拒绝采样：只接受位于截断区间内的正态样本
for (int i = 0; i < 100; i++) {

    double value = normal(mean, std);

    if (Double.isFinite(value)
        && value >= lower
        && value <= upper) {

        return value;
    }
}

// 极低概率下的保护返回
return Math.max(
    lower,
    Math.min(upper, mean)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406812940</Id>
					<Name><![CDATA[clip]]></Name>
					<X>-440</X><Y>-840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[value]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lower]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[upper]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return Math.max(lower, Math.min(upper, value));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406852354</Id>
					<Name><![CDATA[gradeReward]]></Name>
					<X>-440</X><Y>-810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[gap]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return clip(1.0 - gradeDeviation(gap), -1.0, 1.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406881298</Id>
					<Name><![CDATA[getCumulativeWaitVehicleSeconds]]></Name>
					<X>-440</X><Y>-780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double waitMinutes =
    totalSystemLoadWaitTime + totalSystemDumpWaitTime;

// 尚未开始服务的车辆也必须持续贡献等待积分
for (Truck t : trucks) {
    if (t.isWaitingForLoadResource) {
        waitMinutes += Math.max(0.0, time(MINUTE) - t.queueEnterTime);
    }

    if (t.isWaitingForDumpResource) {
        waitMinutes += Math.max(
            0.0,
            time(MINUTE) - t.dumpQueueEnterTime
        );
    }
}

return waitMinutes * 60.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406915714</Id>
					<Name><![CDATA[settleCurrent2hWindow]]></Name>
					<X>-440</X><Y>-750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (currentWindowIndex < 0 || currentWindowIndex >= 4) {
    throw new IllegalStateException(
        "Invalid 2h window index: " + currentWindowIndex
    );
}
DumpSite crusher = getDumpSiteById(0);

double boundarySec =
    (currentWindowIndex + 1) * rlWindowSeconds;

// 封窗时，破碎积分时钟必须恰好推进到对应边界。
if (crusher == null
    || !Double.isFinite(crusher.crusherClockSec)
    || Math.abs(crusher.crusherClockSec - boundarySec) > 1e-7) {

    throw new IllegalStateException(
        "Window settled away from crusher boundary: window="
        + currentWindowIndex
        + " boundary=" + boundarySec
        + " crusherClock="
        + (crusher == null
            ? "NULL"
            : Double.toString(crusher.crusherClockSec))
    );
}

double maxWindowTons =
    crusher.crusherRateTph * rlWindowSeconds / 3600.0;

if (!Double.isFinite(maxWindowTons) || maxWindowTons <= 0.0
    || !Double.isFinite(windowOreTons) || windowOreTons < 0.0
    || !Double.isFinite(windowMetalTons) || windowMetalTons < 0.0
    || windowMetalTons > windowOreTons + 1e-6
    || windowOreTons > maxWindowTons + 1e-5) {

    throw new IllegalStateException(
        "Invalid window material/capacity: window="
        + currentWindowIndex
        + " tons=" + windowOreTons
        + " metal=" + windowMetalTons
        + " maxTons=" + maxWindowTons
    );
}
double grade = windowOreTons > 0
    ? windowMetalTons / windowOreTons
    : 0.0;

double gap = windowOreTons > 0
    ? targetGrade - grade
    : targetGrade;

closedWindowOreTons[currentWindowIndex] = windowOreTons;
closedWindowMetalTons[currentWindowIndex] = windowMetalTons;
closedWindowGrades[currentWindowIndex] = grade;
closedWindowGradeGaps[currentWindowIndex] = gap;

double rawGradeReward = gradeReward(gap);
double weightedGradeReward = wGrade2h * rawGradeReward;

pendingGrade2hReward += weightedGradeReward;

pendingClosedWindows.add(
    WindowSummary.newBuilder()
        .setWindowIndex(currentWindowIndex)
        .setWindowStartSeconds(currentWindowIndex * rlWindowSeconds)
        .setWindowEndSeconds((currentWindowIndex + 1) * rlWindowSeconds)
        .setOreTons(windowOreTons)
        .setMetalTons(windowMetalTons)
        .setGrade(grade)
        .setGradeGap(gap)
        .setGradeRewardRaw(rawGradeReward)
        .setGradeRewardWeighted(weightedGradeReward)
        .setViolationUpper(windowOreTons > 0.0 && grade > gradeUpperBound + 1e-12)
        .setViolationLower(windowOreTons <= 0.0 || grade < gradeLowerBound - 1e-12)
        .build()
);

currentWindowIndex++;
windowOreTons = 0.0;
windowMetalTons = 0.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406935927</Id>
					<Name><![CDATA[advanceCompletedGradeWindows]]></Name>
					<X>-440</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nowSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(nowSec)) {
    throw new IllegalArgumentException("Invalid grade-window time");
}

DumpSite crusher = getDumpSiteById(0);

if (crusher == null || !crusher.acceptsOre) {
    throw new IllegalStateException("Missing ore crusher");
}

// 只有实际完成破碎积分的时间，才允许用于结算窗口。
// 即使当前仿真时间已经越过边界，也不能提前封窗。
double processedSec = Math.min(
    Math.min(nowSec, crusher.crusherClockSec),
    rlShiftSeconds
);

// 前三个窗口在破碎推进过程中结算。
// 第四个仍由 finishEpisodeAndNotify() 结算。
while (
    currentWindowIndex < 3
    && processedSec >= (currentWindowIndex + 1) * rlWindowSeconds
) {
    settleCurrent2hWindow();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790407312841</Id>
					<Name><![CDATA[finishEpisodeAndNotify]]></Name>
					<X>-440</X><Y>-670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (episodeClosed) {
    return;
}
auditClose("finishEpisodeAndNotify must run at cutoff", time(SECOND), rlShiftSeconds);
double nowSec = rlShiftSeconds;
// 协调站点结转至班末；破碎业务状态仍由该 DumpSite 自己维护。
getDumpSiteById(0).advanceCrusherTo(nowSec);

// 先关闭尚未关闭的前三个窗口
advanceCompletedGradeWindows(nowSec);

// 再关闭第 4 个窗口
if (currentWindowIndex == 3) {
    settleCurrent2hWindow();
}
if (enableMaterialAudit) {
    printMaterialAuditSummary();
}
printIdleTimeSummary();
double shiftGrade =
    crusherOreTons > 0
    ? crusherMetalTons / crusherOreTons
    : 0.0;

double shiftGap =
    crusherOreTons > 0
    ? targetGrade - shiftGrade
    : targetGrade;

pendingGradeShiftReward =
    calculateShiftGradeReward(shiftGap);

double productionFraction =
    crusherOreTons / targetOreTonsShift;

double productionShortfall =
    clip(1.0 - productionFraction, 0.0, 1.0);

pendingProductionReward =
    calculateOreShortfallReward(crusherOreTons);

double wasteFraction =
    targetWasteTonsShift > 0.0
    ? totalWasteMoved / targetWasteTonsShift
    : 0.0;

double wasteShortfall =
    targetWasteTonsShift > 0.0
    ? clip(1.0 - wasteFraction, 0.0, 1.0)
    : 0.0;

double wasteReward =
    calculateWasteShortfallReward(totalWasteMoved);

double cumulativeWait = getCumulativeWaitVehicleSeconds();

double wasteShortfallTons = Math.max(0.0, targetWasteTonsShift - totalWasteMoved);
double oreShortfallTons = Math.max(0.0, targetOreTonsShift - crusherOreTons);
double carriedOre = 0.0;
double carriedWaste = 0.0;
double loadingReserved = 0.0;
for (Truck truck : trucks) {
    if (truck.isLoaded) {
        if (truck.payloadIsOre) carriedOre += truck.payloadTons;
        else carriedWaste += truck.payloadTons;
    }
    loadingReserved += truck.plannedPayloadTons;
}
DumpSite crusherSite = getDumpSiteById(0);
double receivedOre = crusherSite.receivedTons;
if (Math.abs(receivedOre - crusherOreTons - crusherSite.crusherStoredTons) > 1e-5) {
    throw new IllegalStateException("Crusher mass balance failed");
}
double completedOreLoads = 0.0;
double completedWasteLoads = 0.0;
double siteReservations = 0.0;
for (LoadSite s : loadSites) {
    if (s.remainingTons < -1e-6 || s.reservedTons < -1e-6
        || s.reservedTons > s.remainingTons + 1e-6) {
        throw new IllegalStateException("Invalid source balance at " + s.siteName);
    }
    siteReservations += s.reservedTons;
    if (s.isOre) completedOreLoads += s.producedTons;
    else completedWasteLoads += s.producedTons;
}
if (Math.abs(completedOreLoads - receivedOre - carriedOre) > 1e-5
    || Math.abs(completedWasteLoads - totalWasteMoved - carriedWaste) > 1e-5
    || Math.abs(siteReservations - loadingReserved) > 1e-5) {
    throw new IllegalStateException("Source/transport mass balance failed");
}
double windowSum = 0.0;
int violations = 0;
for (int i = 0; i < 4; i++) {
    windowSum += closedWindowOreTons[i];
    if (closedWindowOreTons[i] <= 0.0
        || closedWindowGrades[i] < gradeLowerBound - 1e-12
        || closedWindowGrades[i] > gradeUpperBound + 1e-12) violations++;
    traceln("[WINDOW] index=" + i + " tons=" + closedWindowOreTons[i]
        + " grade=" + closedWindowGrades[i]);
}
if (Math.abs(windowSum - crusherOreTons) > 1e-5) {
    throw new IllegalStateException("Window tons do not sum to shift output");
}
traceln("[SHIFT] crushedOre=" + crusherOreTons
    + " oreShortfall=" + oreShortfallTons
    + " wasteDelivered=" + totalWasteMoved
    + " wasteShortfall=" + wasteShortfallTons
    + " wasteMet=" + (wasteShortfallTons <= 1e-6)
    + " windowViolations=" + violations
    + " receivedOre=" + receivedOre
    + " bufferTons=" + crusherSite.crusherStoredTons
    + " unloadingReserved=" + crusherSite.crusherReservedTons
    + " carriedOre=" + carriedOre + " carriedWaste=" + carriedWaste
    + " assignedNotLoaded=" + loadingReserved
    + " waitVehicleSeconds=" + cumulativeWait);
if (currentDispatchPolicy >= 0 && currentDispatchPolicy <= 2) {
    double loadWaitMin = totalSystemLoadWaitTime;
    double dumpWaitMin = totalSystemDumpWaitTime;
    for (Truck other : trucks) {
        if (other.isWaitingForLoadResource) loadWaitMin += Math.max(0.0, time(MINUTE) - other.queueEnterTime);
        if (other.isWaitingForDumpResource) dumpWaitMin += Math.max(0.0, time(MINUTE) - other.dumpQueueEnterTime);
    }
    StringBuilder json = new StringBuilder("{\"type\":\"terminal\",\"policy\":");
    json.append(currentDispatchPolicy).append(",\"run_index\":").append(experimentRunIndex)
        .append(",\"experiment_seed\":").append(experimentSeed)
        .append(",\"sim_time_seconds\":").append(nowSec)
        .append(",\"ore_tons_shift\":").append(crusherOreTons)
        .append(",\"waste_tons_shift\":").append(totalWasteMoved)
        .append(",\"waste_target_tons\":").append(targetWasteTonsShift)
        .append(",\"waste_shortfall_tons\":").append(wasteShortfallTons)
        .append(",\"crusher_received_tons\":").append(receivedOre)
        .append(",\"crusher_buffer_tons\":").append(crusherSite.crusherStoredTons)
        .append(",\"metal_tons_shift\":").append(crusherMetalTons)
        .append(",\"grade_shift\":").append(shiftGrade)
        .append(",\"grade_gap_shift\":").append(shiftGap)
        .append(",\"wait_vehicle_seconds\":").append(cumulativeWait)
        .append(",\"load_wait_vehicle_seconds\":").append(loadWaitMin * 60.0)
        .append(",\"dump_wait_vehicle_seconds\":").append(dumpWaitMin * 60.0)
        .append(",\"windows\":[");
    for (int i = 0; i < pendingClosedWindows.size(); i++) {
        if (i > 0) json.append(",");
        WindowSummary w = pendingClosedWindows.get(i);
        json.append("{\"window_index\":").append(w.getWindowIndex())
            .append(",\"window_start_seconds\":").append(w.getWindowStartSeconds())
            .append(",\"window_end_seconds\":").append(w.getWindowEndSeconds())
            .append(",\"ore_tons\":").append(w.getOreTons())
            .append(",\"metal_tons\":").append(w.getMetalTons())
            .append(",\"grade\":").append(w.getGrade())
            .append(",\"grade_gap\":").append(w.getGradeGap())
            .append(",\"violation_upper\":").append(w.getViolationUpper())
            .append(",\"violation_lower\":").append(w.getViolationLower()).append("}");
    }
    json.append("],\"load_sites\":[");
    for (int i = 0; i < loadSites.size(); i++) {
        if (i > 0) json.append(",");
        LoadSite site = loadSites.get(i);
        json.append("{\"site_id\":").append(site.siteId)
            .append(",\"grade\":").append(site.grade)
            .append(",\"produced_tons_at_terminal\":").append(site.producedTons).append("}");
    }
    json.append("]}");
    //ruleEvalWrite(json.toString());
    episodeClosed = true;
    getEngine().finish();
    return;
}

double deltaWaitVehicleSeconds = Math.max(
    0.0,
    cumulativeWait - lastWaitVehicleSeconds
);

double waitReward = -wWait * clip(
    (deltaWaitVehicleSeconds / Math.max(1, trucks.size()))
        / waitRefSeconds,
    0.0,
    1.0
);

double finalReward =
    waitReward
    + pendingGradeActionReward
    + pendingGrade2hReward
    + pendingGradeShiftReward
    + pendingProductionReward
    + wasteReward;
      
Observation terminalObs;
if (usePhysicalObservation) {
    terminalObs = buildPhysicalObservation(null);
} else {
    terminalObs = lastDispatchObservation;
    if (terminalObs == null) {
        if (trucks.isEmpty()) throw new IllegalStateException("No terminal observation");
        terminalObs = buildObservation(trucks.get(0));
    }
}

long seq = decisionSequence++;

DispatchRequest request = DispatchRequest.newBuilder()
    .setTruckId(-1)
    .setObs(terminalObs)
    .setEpisodeId(episodeId)
    .setDecisionSequence(seq)
    .setRequestId(episodeId + "-" + seq)
    .setKind(DispatchKind.EPISODE_END)
    .setActionRequired(false)
    .setPreviousAction(previousAction)
    .setTransitionReward(finalReward)
    .putRewardComponents("wait", waitReward)
    .putRewardComponents("grade_2h", pendingGrade2hReward)
    .putRewardComponents("grade_shift", pendingGradeShiftReward)
    .putRewardComponents("production", pendingProductionReward)
    .putRewardComponents("waste", wasteReward)
	.putRewardComponents("waste_tons_shift", totalWasteMoved)
	.putRewardComponents("waste_target_tons", targetWasteTonsShift)
	.putRewardComponents("waste_fraction_raw", wasteFraction)
	.putRewardComponents("waste_shortfall", wasteShortfall)
	.putRewardComponents(
	    "grade_action_enabled",
	    enableGradeActionReward ? 1.0 : 0.0
	)
    .putRewardComponents(
        "delta_wait_vehicle_seconds",
        deltaWaitVehicleSeconds
    )
    .putRewardComponents("shift_grade", shiftGrade)
	.putRewardComponents("grade_gap_shift", shiftGap)
	.putRewardComponents(
	    "grade_shift_reward_raw",
	    gradeReward(shiftGap)
	)
	.putRewardComponents(
	    "production_fraction_raw",
	    productionFraction
	)
	.putRewardComponents("ore_tons_shift", crusherOreTons)
    .setSimTimeSeconds(nowSec)
    .setSimTimeDeltaSeconds(
        Math.max(0.0, nowSec - lastDecisionTimeSec)
    )
	.putRewardComponents(
	    "grade_action",
	    pendingGradeActionReward
	)
	.putRewardComponents(
	    "production_shortfall",
	    productionShortfall
	)
    .setTerminated(true)
    .setTruncated(false)
	.addAllClosedWindows(pendingClosedWindows)
	.setExperimentRunIndex(experimentRunIndex)
	.setExperimentSeed(experimentSeed)
	.setRewardContractId(rewardContractId)
	.putAllRewardComponents(buildRewardConfigComponents())
    .build();

rlClient.getDispatchResult(request);
pendingClosedWindows.clear();
episodeClosed = true;
getEngine().finish();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790420964895</Id>
					<Name><![CDATA[gradeDeviation]]></Name>
					<X>-450</X><Y>-640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[gap]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(gap)) return 3.0;
double allowance = gap < 0.0
    ? gradeUpperBound - targetGrade
    : targetGrade - gradeLowerBound;
if (allowance <= 0.0) throw new IllegalStateException("Invalid grade interval");
return clip(Math.abs(gap) / allowance, 0.0, 3.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790420996711</Id>
					<Name><![CDATA[calculateGradeActionReward]]></Name>
					<X>-450</X><Y>-610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (!enableGradeActionReward) {
    return 0.0;
}

LoadSite site = getLoadSiteById(action);

if (site == null) {
    throw new IllegalStateException(
        "Invalid load site for grade action reward: " + action
    );
}

if (!site.isOre) {
    return 0.0;
}
double expectedTons = Math.max(1.0, t.capacity);
double priorTons = Math.max(gradePriorTons, expectedTons);

// --------------------------------------------------
// 1. 当前2小时窗口的反事实品位变化
// 使用目标品位的虚拟初始矿量，避免窗口初期一辆车
// 就把品位从0.25跳到0.38或0.15。
// --------------------------------------------------

double windowTonsBefore = windowOreTons + priorTons;
double windowMetalBefore =
    windowMetalTons + priorTons * targetGrade;

double windowGradeBefore =
    windowMetalBefore / windowTonsBefore;

double windowGapBefore =
    targetGrade - windowGradeBefore;

double windowTonsAfter =
    windowTonsBefore + expectedTons;

double windowMetalAfter =
    windowMetalBefore + expectedTons * site.grade;

double windowGradeAfter =
    windowMetalAfter / windowTonsAfter;

double windowGapAfter =
    targetGrade - windowGradeAfter;

double windowImprovement =
    gradeDeviation(windowGapBefore)
    - gradeDeviation(windowGapAfter);

windowImprovement = clip(
    windowImprovement,
    -gradeActionDeltaClip,
    gradeActionDeltaClip
);

// --------------------------------------------------
// 2. 班次累计品位的反事实变化
// --------------------------------------------------

double shiftTonsBefore =
    crusherOreTons + priorTons;

double shiftMetalBefore =
    crusherMetalTons + priorTons * targetGrade;

double shiftGradeBefore =
    shiftMetalBefore / shiftTonsBefore;

double shiftGapBefore =
    targetGrade - shiftGradeBefore;

double shiftTonsAfter =
    shiftTonsBefore + expectedTons;

double shiftMetalAfter =
    shiftMetalBefore + expectedTons * site.grade;

double shiftGradeAfter =
    shiftMetalAfter / shiftTonsAfter;

double shiftGapAfter =
    targetGrade - shiftGradeAfter;

double shiftImprovement =
    gradeDeviation(shiftGapBefore)
    - gradeDeviation(shiftGapAfter);

shiftImprovement = clip(
    shiftImprovement,
    -gradeActionDeltaClip,
    gradeActionDeltaClip
);

// 当前窗口更重要，班次累计用于防止窗口间抵消
double rawReward =
    0.70 * windowImprovement
    + 0.30 * shiftImprovement;

return wGradeAction * rawReward;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791803162690</Id>
					<Name><![CDATA[ruleEvalWrite]]></Name>
					<X>-990</X><Y>-800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[try {
    java.nio.file.Path folder = java.nio.file.Paths.get("ore_waste_validation");
    java.nio.file.Files.createDirectories(folder);
    java.nio.file.Path path = folder.resolve("policy" + currentDispatchPolicy
        + "_run" + experimentRunIndex + "_seed" + experimentSeed + ".jsonl");
    if (!ruleEvalLogStarted) {
        java.nio.file.Files.createFile(path);
        ruleEvalLogStarted = true;
    }
    java.nio.file.Files.write(path,
        (json + "\n").getBytes(java.nio.charset.StandardCharsets.UTF_8),
        java.nio.file.StandardOpenOption.APPEND);
} catch (java.io.IOException e) {
    throw new RuntimeException("Validation log write failed; use a new run index", e);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792419661450</Id>
					<Name><![CDATA[recordWasteDelivery]]></Name>
					<X>-260</X><Y>-280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(tons) || tons <= 0.0) {
    throw new IllegalArgumentException("Invalid delivered waste tons");
}
totalWasteMoved += tons;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792496830061</Id>
					<Name><![CDATA[auditRequire]]></Name>
					<X>-990</X><Y>-410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[condition]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792496857170</Id>
					<Name><![CDATA[auditClose]]></Name>
					<X>-990</X><Y>-380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[label]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[actual]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[expected]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[auditRequire(Double.isFinite(actual) && Double.isFinite(expected),
    label + " non-finite actual=" + actual + " expected=" + expected);
double tolerance = 1e-5 + 1e-9 * Math.max(Math.abs(actual), Math.abs(expected));
auditRequire(Math.abs(actual - expected) <= tolerance,
    label + " actual=" + actual + " expected=" + expected
    + " error=" + (actual - expected) + " tolerance=" + tolerance);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792496994948</Id>
					<Name><![CDATA[auditMaterialBalances]]></Name>
					<X>-990</X><Y>-350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[where]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (!enableMaterialAudit || !materialAuditReady) return;
String p = where;
double carriedOre = 0.0, carriedOreMetal = 0.0, carriedWaste = 0.0;
for (Truck t : trucks) {
    String q = p + " truck=" + t.truckId;
    auditRequire(Double.isFinite(t.plannedPayloadTons) && t.plannedPayloadTons >= 0.0,
        q + " invalid plannedPayloadTons");
    auditRequire(Double.isFinite(t.capacity) && t.capacity > 0.0, q + " invalid capacity");
    auditRequire(t.plannedPayloadTons <= t.capacity + 1e-6, q + " reservation exceeds capacity");
    if (t.plannedPayloadTons > 0.0) {
        auditRequire(!t.isLoaded && t.targetShovel != null && loadSites.contains(t.targetShovel),
            q + " reservation has no valid source or truck is already loaded");
        auditRequire(t.targetLoadSiteId == t.targetShovel.siteId,
            q + " targetLoadSiteId differs from targetShovel");
    }
    auditRequire(Double.isFinite(t.payloadTons) && t.payloadTons >= 0.0,
        q + " invalid payloadTons");
    if (t.isLoaded) {
        auditRequire(t.payloadTons > 0.0 && t.payloadTons <= t.capacity + 1e-6,
            q + " invalid loaded payload");
        auditClose(q + " loaded truck has no source reservation", t.plannedPayloadTons, 0.0);
        auditRequire(Double.isFinite(t.payloadGrade) && t.payloadGrade >= 0.0
            && t.payloadGrade <= 1.0, q + " invalid payloadGrade");
        if (t.payloadIsOre) {
            carriedOre += t.payloadTons;
            carriedOreMetal += t.payloadTons * t.payloadGrade;
        } else {
            carriedWaste += t.payloadTons;
            auditClose(q + " waste-grade=0", t.payloadGrade, 0.0);
        }
    } else {
        auditClose(q + " empty truck payload=0", t.payloadTons, 0.0);
    }
}

double minedOre = 0.0, minedOreMetal = 0.0, minedWaste = 0.0;
for (LoadSite s : loadSites) {
    s.auditSourceBalance(where);
    if (s.isOre) {
        minedOre += s.producedTons;
        minedOreMetal += s.producedMetalTons;
    } else minedWaste += s.producedTons;
}
double deliveredWaste = 0.0;
int crusherCount = 0;
for (DumpSite d : dumpSites) {
    d.auditDumpBalance(where);
    if (d.acceptsOre) crusherCount++;
    if (d.acceptsWaste && !d.acceptsOre) deliveredWaste += d.receivedTons;
}
auditRequire(crusherCount == 1, p + " expected exactly one ore crusher");
DumpSite crusher = getDumpSiteById(0);
auditRequire(crusher != null && crusher.acceptsOre, p + " missing crusher at siteId=0");
auditClose(p + " ore: mined=carried+received", minedOre, carriedOre + crusher.receivedTons);
auditClose(p + " ore-metal: mined=carried+received",
    minedOreMetal, carriedOreMetal + crusher.receivedMetalTons);
auditClose(p + " waste: mined=carried+delivered", minedWaste, carriedWaste + totalWasteMoved);
auditClose(p + " waste: delivered=sites", totalWasteMoved, deliveredWaste);
auditClose(p + " totalProduction=crushedOre", totalProduction, crusherOreTons);

auditRequire(currentWindowIndex >= 0 && currentWindowIndex <= 4, p + " invalid window index");
auditRequire(closedWindowOreTons != null && closedWindowOreTons.length == 4
    && closedWindowMetalTons != null && closedWindowMetalTons.length == 4
    && closedWindowGrades != null && closedWindowGrades.length == 4,
    p + " invalid window array size");
double allTons = windowOreTons, allMetal = windowMetalTons;
auditRequire(Double.isFinite(windowOreTons) && windowOreTons >= 0.0
    && Double.isFinite(windowMetalTons) && windowMetalTons >= 0.0
    && windowMetalTons <= windowOreTons + 1e-6, p + " invalid current window material");
for (int i = 0; i < 4; i++) {
    double tons = closedWindowOreTons[i], metal = closedWindowMetalTons[i];
    auditRequire(Double.isFinite(tons) && tons >= 0.0
        && Double.isFinite(metal) && metal >= 0.0 && metal <= tons + 1e-6,
        p + " invalid closed window=" + i);
    if (i < currentWindowIndex) {
        allTons += tons;
        allMetal += metal;
        if (tons > 0.0) {
            auditRequire(Double.isFinite(closedWindowGrades[i])
                && Math.abs(closedWindowGrades[i] - metal / tons) <= 1e-10,
                p + " product grade mismatch at window=" + i);
        } else auditClose(p + " empty-window-metal=" + i, metal, 0.0);
    } else {
        auditClose(p + " unclosed-window-tons=" + i, tons, 0.0);
        auditClose(p + " unclosed-window-metal=" + i, metal, 0.0);
    }
}
auditClose(p + " window-tons=shift-tons", allTons, crusherOreTons);
auditClose(p + " window-metal=shift-metal", allMetal, crusherMetalTons);
if (currentWindowIndex == 4) {
    auditClose(p + " terminal current-window-tons=0", windowOreTons, 0.0);
    auditClose(p + " terminal current-window-metal=0", windowMetalTons, 0.0);
}
materialAuditChecks++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792497019268</Id>
					<Name><![CDATA[printMaterialAuditSummary]]></Name>
					<X>-990</X><Y>-320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[auditRequire(enableMaterialAudit && materialAuditReady,
    "Enable material audit before printing a PASS report");
auditRequire(currentWindowIndex == 4, "Terminal report requires four closed windows");
auditClose("terminal time", time(SECOND), rlShiftSeconds);
auditMaterialBalances("SHIFT_END");
DumpSite crusher = getDumpSiteById(0);
auditClose("terminal crusher clock", crusher.crusherClockSec, rlShiftSeconds);

// Each loaded truck belongs to exactly one category. Q is not an extra material bin.
double oreOutsideUnload = 0.0, oreUnloading = 0.0;
double wasteOutsideUnload = 0.0, wasteUnloading = 0.0;
double assignedNotLoaded = 0.0;
for (Truck t : trucks) {
    assignedNotLoaded += t.plannedPayloadTons;
    if (!t.isLoaded) continue;
    boolean unloading = "DUMPING".equals(t.executionPhase)
        && t.dumpServiceStartTime * 60.0 < rlShiftSeconds;
    if (t.payloadIsOre) {
        if (unloading) oreUnloading += t.payloadTons;
        else oreOutsideUnload += t.payloadTons;
    } else {
        if (unloading) wasteUnloading += t.payloadTons;
        else wasteOutsideUnload += t.payloadTons;
    }
    traceln("[AUDIT_TRUCK] id=" + t.truckId + " ore=" + t.payloadIsOre
        + " tons=" + t.payloadTons + " grade=" + t.payloadGrade
        + " phase=" + t.executionPhase + " unloadingInShift=" + unloading);
}
double minedOre = 0.0, minedOreMetal = 0.0, minedWaste = 0.0;
for (LoadSite s : loadSites) {
    traceln("[AUDIT_SOURCE] name=" + s.siteName
        + " initial=" + s.initialReserveTons + " remaining=" + s.remainingTons
        + " mined=" + s.producedTons + " reserved=" + s.reservedTons
        + " minedMetal=" + s.producedMetalTons
        + " stockError=" + (s.initialReserveTons - s.remainingTons - s.producedTons));
    if (s.isOre) { minedOre += s.producedTons; minedOreMetal += s.producedMetalTons; }
    else minedWaste += s.producedTons;
}
double bufferMetal = crusher.auditBufferMetalTons();
auditClose("terminal ore exclusive bins", minedOre,
    oreOutsideUnload + oreUnloading + crusher.crusherStoredTons + crusherOreTons);
auditClose("terminal waste exclusive bins", minedWaste,
    wasteOutsideUnload + wasteUnloading + totalWasteMoved);
auditClose("terminal Q=oreUnloading", crusher.crusherReservedTons, oreUnloading);
traceln("[AUDIT_BUFFER] B=" + crusher.crusherStoredTons
    + " Q=" + crusher.crusherReservedTons
    + " used=" + (crusher.crusherStoredTons + crusher.crusherReservedTons)
    + " capacity=" + crusher.crusherBufferCapacityTons
    + " bufferMetal=" + bufferMetal);
traceln("[AUDIT_SHIFT] minedOre=" + minedOre + " minedOreMetal=" + minedOreMetal
    + " oreCarriedExcludingUnload=" + oreOutsideUnload + " oreUnloading=" + oreUnloading
    + " bufferOre=" + crusher.crusherStoredTons + " crushedOre=" + crusherOreTons
    + " crushedMetal=" + crusherMetalTons
    + " minedWaste=" + minedWaste + " wasteCarriedExcludingUnload=" + wasteOutsideUnload
    + " wasteUnloading=" + wasteUnloading + " wasteDelivered=" + totalWasteMoved
    + " assignedNotLoaded=" + assignedNotLoaded);
for (int i = 0; i < 4; i++) {
    double tons = closedWindowOreTons[i], metal = closedWindowMetalTons[i];
    boolean noSupply = tons <= 0.0;
    double g = noSupply ? 0.0 : metal / tons;
    boolean gradeMet = !noSupply && g >= gradeLowerBound - 1e-12
        && g <= gradeUpperBound + 1e-12;
    String status = noSupply ? "NO_SUPPLY" : (gradeMet ? "GRADE_OK" : "GRADE_OUT");
    traceln("[AUDIT_WINDOW] index=" + i + " tons=" + tons + " metal=" + metal
        + " grade=" + (noSupply ? "NA" : Double.toString(g))
        + " noSupply=" + noSupply + " gradeMet=" + gradeMet + " status=" + status);
}
traceln("[MATERIAL_AUDIT_PASS] checks=" + materialAuditChecks
    + " tSec=" + time(SECOND));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792500308564</Id>
					<Name><![CDATA[printIdleTimeSummary]]></Name>
					<X>-990</X><Y>-290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double elapsedSec = Math.max(
    0.0,
    Math.min(time(SECOND), rlShiftSeconds)
);

double fleetIdleSec = 0.0;

for (Truck t : trucks) {
    double idleSec = t.getTruckIdleSeconds();

    if (!Double.isFinite(idleSec)
        || idleSec < -1e-6
        || idleSec > elapsedSec + 1e-6) {

        throw new IllegalStateException(
            "Invalid truck idle time: truck=" + t.truckId
            + " idleSec=" + idleSec
            + " elapsedSec=" + elapsedSec
        );
    }

    fleetIdleSec += idleSec;

    double idleRatio = elapsedSec > 0.0
        ? idleSec / elapsedSec
        : 0.0;

    traceln(
        "[TRUCK_IDLE] id=" + t.truckId
        + " idleMin=" + idleSec / 60.0
        + " idlePct=" + idleRatio * 100.0
    );
}

double shovelIdleSec = 0.0;

for (LoadSite s : loadSites) {
    double idleSec = s.getShovelIdleSeconds();

    if (!Double.isFinite(idleSec)
        || idleSec < -1e-6
        || idleSec > elapsedSec + 1e-6) {

        throw new IllegalStateException(
            "Invalid shovel idle time: site=" + s.siteName
            + " idleSec=" + idleSec
            + " elapsedSec=" + elapsedSec
        );
    }

    shovelIdleSec += idleSec;

    double loadingSec = elapsedSec - idleSec;

    double utilization = elapsedSec > 0.0
        ? loadingSec / elapsedSec
        : 0.0;

    traceln(
        "[SHOVEL_IDLE] site=" + s.siteName
        + " idleMin=" + idleSec / 60.0
        + " loadingMin=" + loadingSec / 60.0
        + " utilizationPct=" + utilization * 100.0
    );
}

double fleetIdlePct =
    elapsedSec > 0.0 && !trucks.isEmpty()
    ? 100.0 * fleetIdleSec / (trucks.size() * elapsedSec)
    : 0.0;

double shovelIdlePct =
    elapsedSec > 0.0 && !loadSites.isEmpty()
    ? 100.0 * shovelIdleSec / (loadSites.size() * elapsedSec)
    : 0.0;

traceln(
    "[IDLE_SHIFT]"
    + " truckIdleVehicleMin=" + fleetIdleSec / 60.0
    + " fleetIdlePct=" + fleetIdlePct
    + " shovelIdleMachineMin=" + shovelIdleSec / 60.0
    + " shovelIdlePct=" + shovelIdlePct
    + " loadDumpWaitVehicleMin="
    + getCumulativeWaitVehicleSeconds() / 60.0
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578295698</Id>
					<Name><![CDATA[obsInit]]></Name>
					<X>-730</X><Y>-200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (trucks.size()!=9 || loadSites.size()!=4 || dumpSites.size()!=2 || segmentMap.size()!=16)
    throw new IllegalStateException("dispatch.physical.v3 requires 9 trucks, 4 loads, 2 dumps, 16 directed segments");
if (!Double.isFinite(speedDtSec) || speedDtSec<=0.0)
    throw new IllegalStateException("Invalid speed control period");
boolean[] ids = new boolean[9];
for (Truck t : trucks) {
    if (t.truckId<0 || t.truckId>=9 || ids[t.truckId]) throw new IllegalStateException("Invalid truck ID");
    ids[t.truckId]=true;
    if (t.capacity < 91.7-1e-8 || t.capacity > 193.0+1e-8)
        throw new IllegalStateException("Recheck FIFO slot bound for changed truck capacities");
}
for (int i=0;i<4;i++) {
    LoadSite s=getLoadSiteById(i);
    if (s==null || s.shovelCapacity!=1 || s.gradeBlockTons<=193.0)
        throw new IllegalStateException("Grade inference requires one shovel/site and payload < block tons");
}
for (String name : obsNodeNames) if(getRoadPointNode(name)==null)
    throw new IllegalStateException("Missing observation node: "+name);
obsSegmentKeys.clear();
obsSegmentKeys.addAll(segmentMap.keySet());
java.util.Collections.sort(obsSegmentKeys);
obsSchemaNames.clear();
obsTraceCount=0L;
obsReady=true;
traceln("[OBS_CONFIG] schema=dispatch.physical.v3 nodes="+java.util.Arrays.toString(obsNodeNames)
    +" segments="+obsSegmentKeys);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792578327721</Id>
					<Name><![CDATA[obsNodeIndex]]></Name>
					<X>-730</X><Y>-170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[name]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if(name==null || name.isEmpty()) return -1;
for(int i=0;i<obsNodeNames.length;i++) if(name.equals(obsNodeNames[i])) return i;
throw new IllegalStateException("Unknown observation node: "+name);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792578351434</Id>
					<Name><![CDATA[obsSegmentIndex]]></Name>
					<X>-730</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[segment]]></Name>
						<Type><![CDATA[PathSegment]]></Type>
					</Parameter>
					<Body><![CDATA[if(segment==null) return -1;
int i=obsSegmentKeys.indexOf(segment.key);
if(i<0) throw new IllegalStateException("Unknown observation segment: "+segment.key);
return i;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Observation]]></ReturnType>
					<Id>1792578690928</Id>
					<Name><![CDATA[buildPhysicalObservation]]></Name>
					<X>-740</X><Y>-90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ego]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[getDumpSiteById(0).advanceCrusherTo(time(SECOND));
advanceCompletedGradeWindows(time(SECOND));
DispatchObsWriter w=collectPhysicalObservation(ego);
Observation.Builder b=Observation.newBuilder().setSchemaId("dispatch.physical.v3");
for(double value:w.values) b.addValues((float)value);
return b.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[DispatchObsWriter]]></ReturnType>
					<Id>1792578878028</Id>
					<Name><![CDATA[collectPhysicalObservation]]></Name>
					<X>-740</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ego]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if(!obsReady) throw new IllegalStateException("Call obsInit() before activating trucks");
double now=time(SECOND);
boolean terminal=now>=rlShiftSeconds;
if(!terminal && ego==null) throw new IllegalArgumentException("Decision truck required");
DumpSite crusher=getDumpSiteById(0);
DispatchObsWriter w=new DispatchObsWriter();
// Business state is read-only here; schema metadata is initialized/validated below.
// Time synchronization belongs to buildPhysicalObservation()/dry run.
if(Math.abs(crusher.crusherClockSec-Math.min(now,rlShiftSeconds))>1e-7)
    throw new IllegalStateException("Synchronize crusher before collecting observation");
w.add("global.shiftElapsed",Math.min(now,rlShiftSeconds)/28800.0);
w.add("global.shiftRemaining",Math.max(0.0,rlShiftSeconds-now)/28800.0);
w.add("global.windowIndex",currentWindowIndex/4.0);
double end=Math.min(rlShiftSeconds,(currentWindowIndex+1.0)*rlWindowSeconds);
w.add("global.windowRemaining",Math.max(0.0,end-now)/7200.0);
w.add("global.windowTons",windowOreTons/5000.0);
w.add("global.windowMetal",windowMetalTons/5000.0);
w.add("global.noSupply",windowOreTons<=0?1:0);
w.add("global.shiftOre",crusherOreTons/20000.0);
w.add("global.shiftMetal",crusherMetalTons/20000.0);
w.add("global.wasteDelivered",totalWasteMoved/4000.0);
w.add("global.wasteShortfall",Math.max(0.0,targetWasteTonsShift-totalWasteMoved)/4000.0);
w.add("global.oreTarget",targetOreTonsShift/20000.0);
w.add("global.wasteTarget",targetWasteTonsShift/4000.0);
w.add("global.gradeLower",gradeLowerBound);
w.add("global.gradeUpper",gradeUpperBound);
w.add("global.gradeTarget",targetGrade);
w.add("global.deterministic",deterministicCheck?1:0);
w.add("global.terminal",terminal?1:0);
w.add("global.speedTickPhase",(now-Math.floor(now/speedDtSec)*speedDtSec)/speedDtSec);
for(int i=0;i<4;i++) {
    LoadSite s=getLoadSiteById(i);
    double availableTons=s.getAvailableTons();
    w.add("actionMask."+i,!terminal && availableTons>1e-6?1:0);
}
for(int i=0;i<4;i++) w.add("actionTons."+i,!terminal?Math.min(ego.capacity,getLoadSiteById(i).getAvailableTons())/193.0:0);
java.util.ArrayList<Truck> ordered =
    new java.util.ArrayList<Truck>();

for (Truck t : trucks) {
    ordered.add(t);
}

java.util.Collections.sort(
    ordered,
    (a, b) -> Integer.compare(a.truckId, b.truckId)
);
for(Truck t:ordered) t.appendDispatchObservation(w,terminal?null:ego);
for(int i=0;i<4;i++) getLoadSiteById(i).appendDispatchObservation(w);
for(int i=0;i<2;i++) getDumpSiteById(i).appendDispatchObservation(w);
crusher.appendCrusherFifoObservation(w);
for(int i=0;i<16;i++) {
    PathSegment s=segmentMap.get(obsSegmentKeys.get(i));
    String p="road."+i+".";
    w.add(p+"from",(obsNodeIndex(s.from)+1.0)/9.0);
    w.add(p+"to",(obsNodeIndex(s.to)+1.0)/9.0);
    w.add(p+"length",s.length/10000.0);
    w.add(p+"limit",s.speedLimit/10.0);
    w.add(p+"closed",s.closed?1:0);
}
if(w.values.size()!=1519) throw new IllegalStateException("Expected 1519 physical observation values, got "+w.values.size());
if(obsSchemaNames.isEmpty()) obsSchemaNames.addAll(w.names);
else if(!obsSchemaNames.equals(w.names)) throw new IllegalStateException("Observation field order changed");
return w;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578933229</Id>
					<Name><![CDATA[obsCheckDecision]]></Name>
					<X>-750</X><Y>-40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ego]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if(!obsDryRun) return;
getDumpSiteById(0).advanceCrusherTo(time(SECOND));
advanceCompletedGradeWindows(time(SECOND));
DispatchObsWriter a=collectPhysicalObservation(ego);
DispatchObsWriter b=collectPhysicalObservation(ego);
if(!a.values.equals(b.values) || !a.names.equals(b.names))
    throw new IllegalStateException("Observation is not repeatable at one simulation instant");
obsTraceCount++;
if(obsTraceCount==1) {
    traceln("[OBS_SCHEMA_BEGIN]\n"+a.schemaCsv()+"[OBS_SCHEMA_END]");
}
if(obsTraceCount<=3 || obsTraceCount%50==0) {
    traceln("[OBS_CHECK] count="+obsTraceCount+" dim="+a.values.size()
        +" tSec="+time(SECOND)+" ego="+ego.truckId
        +" mask="+a.values.subList(19,23));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792626274567</Id>
					<Name><![CDATA[calculateShiftGradeReward]]></Name>
					<X>-450</X><Y>-580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[shiftGap]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return wGradeShift * gradeReward(shiftGap);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792626298791</Id>
					<Name><![CDATA[calculateOreShortfallReward]]></Name>
					<X>-450</X><Y>-550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[oreTons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return -wProduction * clip(
    1.0 - oreTons / targetOreTonsShift,
    0.0,
    1.0
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792626332640</Id>
					<Name><![CDATA[calculateWasteShortfallReward]]></Name>
					<X>-450</X><Y>-520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[wasteTons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (targetWasteTonsShift <= 0.0) {
    return 0.0;
}

return -wWasteShortfall * clip(
    1.0 - wasteTons / targetWasteTonsShift,
    0.0,
    1.0
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.Map<String, Double>]]></ReturnType>
					<Id>1792628306654</Id>
					<Name><![CDATA[buildRewardConfigComponents]]></Name>
					<X>-990</X><Y>-770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.Map<String, Double> c = new java.util.LinkedHashMap<String, Double>();
c.put("grade_action_enabled", enableGradeActionReward ? 1.0 : 0.0);
c.put("config.waste_shortfall_weight", wWasteShortfall);
c.put("config.target_waste_tons_shift", targetWasteTonsShift);
c.put("config.num_trucks", (double) trucks.size());
c.put("config.target_grade", targetGrade);
c.put("config.grade_lower", gradeLowerBound);
c.put("config.grade_upper", gradeUpperBound);
c.put("config.wait_ref_seconds", waitRefSeconds);
c.put("config.target_ore_tons_2h", targetOreTons2h);
c.put("config.target_ore_tons_shift", targetOreTonsShift);
c.put("config.w_wait", wWait);
c.put("config.w_grade_2h", wGrade2h);
c.put("config.w_grade_shift", wGradeShift);
c.put("config.w_production", wProduction);
c.put("config.w_grade_action", wGradeAction);
c.put("config.grade_prior_tons", gradePriorTons);
c.put("config.grade_action_delta_clip", gradeActionDeltaClip);
return c;]]></Body>
				</Function>
			</Functions>
