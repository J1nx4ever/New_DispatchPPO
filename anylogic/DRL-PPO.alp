					<Id>1782892832936</Id>
					<Name><![CDATA[NeedDispatchToDumpSite]]></Name>
					<X>600</X><Y>1060</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
