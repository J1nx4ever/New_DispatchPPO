import io.grpc.ManagedChannel;
import io.grpc.ManagedChannelBuilder;
import io.grpc.StatusRuntimeException;
import java.util.concurrent.TimeUnit;

public class RLClient {
private final ManagedChannel channel;
private final DispatchServiceGrpc.DispatchServiceBlockingStub blockingStub;
private final long timeoutMs;

public RLClient(String var1, int var2, long var3) {
   this.channel = ManagedChannelBuilder.forAddress(var1, var2).usePlaintext().build();
   this.blockingStub = DispatchServiceGrpc.newBlockingStub(this.channel);
   this.timeoutMs = var3;
}

public DispatchResponse getDispatchResult(
	    DispatchRequest request
	) throws StatusRuntimeException {

	    if (request == null || !request.hasObs()) {
	        throw new IllegalArgumentException("request.obs is required");
	    }

	    DispatchResponse response =
	        blockingStub
	            .withDeadlineAfter(timeoutMs, TimeUnit.MILLISECONDS)
	            .getNextDestination(request);

	    if (!request.getEpisodeId().equals(response.getEpisodeId())) {
	        throw new IllegalStateException("episode_id mismatch");
	    }

	    if (
	        request.getDecisionSequence()
	        != response.getDecisionSequence()
	    ) {
	        throw new IllegalStateException(
	            "decision_sequence mismatch"
	        );
	    }

	    if (request.getActionRequired()) {
	        if (!response.getHasAction()) {
	            throw new IllegalStateException(
	                "Action required but response has no action"
	            );
	        }

	        int action = response.getAction();
	        if (action < 0 || action > 3) {
	            throw new IllegalStateException(
	                "Invalid action: " + action
	            );
	        }
	    }

	    return response;
	}

public int getNextDestination(DispatchRequest var1) throws StatusRuntimeException {
   return this.getDispatchResult(var1).getAction();
}

public boolean isReady() {
   ConnectivityState var1 = this.channel.getState(true);
   return !this.channel.isShutdown() && !this.channel.isTerminated() && var1 != ConnectivityState.SHUTDOWN;
}

public void shutdown() {
   this.channel.shutdown();

   try {
      if (!this.channel.awaitTermination(5L, TimeUnit.SECONDS)) {
         this.channel.shutdownNow();
      }
   } catch (InterruptedException var2) {
      this.channel.shutdownNow();
      Thread.currentThread().interrupt();
   }

}
}
