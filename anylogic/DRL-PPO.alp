						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[10]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1783411200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[for (Truck t : trucks) {
    t.updateBasicSpeedState();
}

updateFrontRearVehicles();
//updateFrontRearVehiclesRouteBased();
//test();
updateConflictVehicles(); 
]]></Action>
				</Event>
				<Event>
					<Id>1783499908420</Id>
					<Name><![CDATA[evApplySpeedActions]]></Name>
					<X>970</X><Y>-730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="condition" Mode="userControls">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[5]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1783584000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[0.1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[double dt = 0.1;
double maxSpeed = 15.0;

for (Truck t : trucks) {

    double currentSpeed = 0;

    try {
        currentSpeed = t.getSpeed();
    } catch (Exception e) {
        currentSpeed = t.egoSpeed;
    }

    double newSpeed = currentSpeed + t.cmdAccel * dt;

    if (newSpeed < 0) {
        newSpeed = 0;
    }

    if (newSpeed > maxSpeed) {
        newSpeed = maxSpeed;
    }

    try {
        t.setSpeed(newSpeed, MPS);
    } catch (Exception e) {
        try {
            t.setSpeed(newSpeed);
        } catch (Exception ex) {
            traceln("[SpeedControl] setSpeed failed for truck " + t.truckId + ": " + ex.getMessage());
        }
    }

    t.egoSpeed = newSpeed;
}]]></Action>
				</Event>
				<Event>
					<Id>1783842998533</Id>
