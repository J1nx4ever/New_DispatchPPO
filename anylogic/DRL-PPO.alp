		<JavaClass>
			<Id>1792577682289</Id>
			<Name><![CDATA[DispatchObsWriter]]></Name>
			<Text><![CDATA[public class DispatchObsWriter {
    public final java.util.ArrayList<Double> values = new java.util.ArrayList<Double>();
    public final java.util.ArrayList<String> names = new java.util.ArrayList<String>();
    private final java.util.HashSet<String> used = new java.util.HashSet<String>();
    public void add(String name, double value) {
        if (!Double.isFinite(value) || !Float.isFinite((float)value))
            throw new IllegalStateException("Invalid observation: " + name + "=" + value);
        if (!used.add(name)) throw new IllegalStateException("Duplicate observation: " + name);
        names.add(name);
        values.add(value);
    }
    public void oneHot(String prefix, int selected, int count) {
        if (selected < -1 || selected >= count) throw new IllegalStateException("Invalid category: " + prefix);
        for (int i=0; i<count; i++) add(prefix + i, selected == i ? 1.0 : 0.0);
    }
    public void truckSlots(String prefix, java.util.List<Truck> list) {
        if (list.size() > 9) throw new IllegalStateException("Queue overflow: " + prefix);
        java.util.HashSet<Truck> seen = new java.util.HashSet<Truck>();
        for (Truck t : list) {
            if (t == null || t.truckId < 0 || t.truckId >= 9 || !seen.add(t))
                throw new IllegalStateException("Invalid queue: " + prefix);
        }
        for (int i=0; i<9; i++) add(prefix+i, i<list.size() ? (list.get(i).truckId+1.0)/9.0 : 0.0);
    }
    public String schemaCsv() {
        StringBuilder b = new StringBuilder("index,name\n");
        for (int i=0; i<names.size(); i++) b.append(i).append(',').append(names.get(i)).append('\n');
        return b.toString();
    }
}]]></Text>
