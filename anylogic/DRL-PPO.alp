						<EntryAction><![CDATA[currentCycleTime = time() - cycleStartTime;

if (!main.isWarmUp) {

    // 本车：每完成一次循环，添加一个样本
    statTruckCycleTime.add(currentCycleTime);

    // 保留原有的装载点统计
    if (targetLoadSiteId >= 0
        && targetLoadSiteId < main.loadingPointStatsList.size()) {

        main.loadingPointStatsList
            .get(targetLoadSiteId)
            .registerCycleTime(currentCycleTime);
    }

    // 保留全局统计
    main.totalCycleTime += currentCycleTime;
    main.completedTrips++;
}]]></EntryAction>
