							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
setShovelIdle(false);
Truck t = (Truck)agent;
numInService++;
t.loadStartTime = time(MINUTE);
double waitTime = Math.max(0.0, t.loadStartTime - t.queueEnterTime);
t.isWaitingForLoadResource = false;
t.lastLoadWaitTime = waitTime;
t.totalLoadWaitTime += waitTime;
totalQueueTime += waitTime;
main.totalSystemLoadWaitTime += waitTime;
main.totalWaitTime += waitTime;
t.obsLoadMaterialStart = extractionCursorTons;
t.payloadGrade = takeMaterialGrade(t.plannedPayloadTons);
t.executionPhase = "LOADING";]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;

numInService = Math.max(0, numInService - 1);
setShovelIdle(numInService == 0);
t.loadFinishTime = time();

double serviceTime = t.loadFinishTime - t.loadStartTime;
totalServiceTime += serviceTime;

/*traceln("Truck " + t.truckId
    + " finishes loading at " + siteName
    + ", serviceTime=" + serviceTime
    + ", numInService=" + numInService);*/]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onRemove]]></Name>
						</Parameter>
					</Parameters>
