					<Body><![CDATA[Point currentPos = new Point(x1, y1);
Point targetPos = new Point(x2, y2);

ContinuousShortestPathData out = new ContinuousShortestPathData();
network.getPathData(currentPos, targetPos, out);

return toLengthUnits(out.distance, METER);]]></Body>
