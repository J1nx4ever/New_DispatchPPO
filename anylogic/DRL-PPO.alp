			<EmbeddedObjects>
				<EmbeddedObject>
					<Id>1776755993339</Id>
					<Name><![CDATA[trucks]]></Name>
					<X>330</X><Y>-240</Y>
					<Label><X>10</X><Y>0</Y></Label>
