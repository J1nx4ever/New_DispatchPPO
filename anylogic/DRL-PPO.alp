			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776756420025</Id>
					<Name><![CDATA[init1]]></Name>
					<X>280</X><Y>-560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ---------- 初始化 LoadSite population ----------

dynamic = true;

LoadSite s0 = add_loadSites();
s0.setLocation(ShovelOreHigh1);
s0.loadNode = ShovelOreHigh1;
s0.initLoadSite(0, "HG1", true, 0.38, 30000, 0.45,
    ShovelOreHigh1.getX(), ShovelOreHigh1.getY(), 13.5, 2.2);


LoadSite s1 = add_loadSites();
s1.setLocation(ShovelOreHigh2);
s1.loadNode = ShovelOreHigh2;
s1.initLoadSite(1, "HG2", true, 0.30, 30000, 0.45,
    ShovelOreHigh2.getX(), ShovelOreHigh2.getY(), 13.5, 2.2);


LoadSite s2 = add_loadSites();
s2.setLocation(ShovelOreLow);
s2.loadNode = ShovelOreLow;
s2.initLoadSite(2, "LG", true, 0.15, 30000, 0.45,
    ShovelOreLow.getX(), ShovelOreLow.getY(), 13.5, 2.2);

LoadSite s3 = add_loadSites();
s3.setLocation(ShovelWaste);
s3.loadNode = ShovelWaste;
s3.initLoadSite(3, "WASTE", false, 0.00, 30000, 0.45,
    ShovelWaste.getX(), ShovelWaste.getY(), 15.0, 2.0);

for(LoadSite s: loadSites){

    layoutEntities.add(
        new LayoutEntity(
            s.siteName,
            "LOAD_SITE",
            s.getX(),
            s.getY()
        )
    );

}

// ---------- 初始化 DumpSite population ----------

DumpSite d0 = add_dumpSites();
d0.setLocation(Crusher);
d0.dumpNode = Crusher;
d0.initDumpSite(0, "Crusher", true, false, 2.5);

DumpSite d1 = add_dumpSites();
d1.setLocation(dumpNode);
d1.dumpNode = dumpNode;
d1.initDumpSite(1, "Dump", false, true, 2.0);


for(DumpSite d: dumpSites){

    layoutEntities.add(
        new LayoutEntity(
            d.siteName,
            "DUMP_SITE",
            d.getX(),
            d.getY()
        )
    );

}

// ---------- 初始化 Truck population ----------

//init_trucks(numTrucks);
for(int i = 0; i < numTrucks; i++){

    Truck t = add_trucks();
    if(i < 3){
    	t.setLocation(collectionTrucks.get(i+25));
    	t.currentNode = "dumpNode";
    	t.startPoint = t.currentNode;
    }
    else{	
        t.setLocation(collectionTrucks.get(i+15));
        t.currentNode = "Crusher";
        t.startPoint = t.currentNode;
     }
     /*if(i > 19){
     	t.setLocation(dumpNode);
 	    t.currentNode = "dumpNode";
    	t.startPoint = t.currentNode;
     }*/
    

    if (dynamic == false){
    	t.targetShovel = getLoadSiteById(0);
    }
	/*
	t.setLocation(collectionTrucks.get(i+15));
	t.currentNode = "Crusher";
	t.startPoint = t.currentNode;
	*/
    
    int k = i / 3;
	double cap =
	    k == 0 ? 91.7 :
	    k == 1 ? 147.0 : 193.0;

	t.initTruck(i, cap);
    t.truckType = k;
	t.initialPredecessor = null;
	t.initialDispatchDone = false;
	t.setSpeed(k == 0 ? 26.0 : k == 1 ? 24.0 : 22.0, KPH);
	for (Truck previous : trucks) {
	    if (previous != t && previous.truckId < t.truckId
	        && previous.currentNode.equals(t.currentNode)
	        && (t.initialPredecessor == null
	            || previous.truckId > t.initialPredecessor.truckId)) {
	        t.initialPredecessor = previous;
	    }
	}

}
// ---------- 初始化 Stats population ----------

for(int i = 0; i < 4 ; i++ ){
	loadingPointStatsList.get(i).loadingPointName = collectionLoadSites.get(i).getName();
}





// ---------- 初始化全局统计 ----------
crusherOreTons = 0;
crusherMetalTons = 0;
currentFeedGrade = 0;
gradeGap = targetGrade - currentFeedGrade;

totalProduction = 0;
totalWasteMoved = 0;
totalWaitTime = 0;
totalTravelTime = 0;
totalCycleTime = 0;
completedTrips = 0;

L2DList = L2D();



]]></Body>
				</Function>
