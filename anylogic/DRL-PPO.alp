				<EmbeddedObject>
					<Id>1783911830683</Id>
					<Name><![CDATA[delayDump]]></Name>
					<X>420</X><Y>350</Y>
					<Label><X>-5</X><Y>-15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Delay]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Delay]]></ClassName>
							<ItemName><![CDATA[1412336242930]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[type]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayTime]]></Name>
							<Value Class="CodeUnitValue">
								<Code><![CDATA[dumpServiceMinutes((Truck)agent)]]></Code>
								<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[capacity]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[5]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[maximumCapacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[entityLocation]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[pushProtocol]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[restoreEntityLocationOnExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;

if (!dumpAdmissionPending) {
    throw new IllegalStateException(
        "Truck entered delayDump without controlled admission: truck="
        + t.truckId + " at " + siteName
    );
}

if (acceptsOre) {
    advanceCrusherTo(time(SECOND));

    if (!canAcceptCrusher(t)) {
        throw new IllegalStateException(
            "Crusher capacity changed before unloading: truck="
            + t.truckId
            + " timeSec=" + time(SECOND)
            + " B=" + crusherStoredTons
            + " Q=" + crusherReservedTons
            + " payload=" + t.payloadTons
            + " capacity=" + crusherBufferCapacityTons
        );
    }

    // 本车开始卸载，预约整车吨位。
    crusherReservedTons += t.payloadTons;
}

numInDumpService++;

t.dumpServiceStartTime = time(MINUTE);

double waitTime = Math.max(
    0.0,
    t.dumpServiceStartTime - t.dumpQueueEnterTime
);

t.isWaitingForDumpResource = false;
t.lastDumpWaitTime = waitTime;
t.totalDumpWaitTime += waitTime;

totalDumpQueueTime += waitTime;
main.totalSystemDumpWaitTime += waitTime;
main.totalWaitTime += waitTime;

t.executionPhase = "DUMPING";

// 至此，本车的预约与卸载状态已经完整更新。
dumpAdmissionPending = false;
obsAdmissionTruck = null;
// 如果已经添加上一份方案的核验函数，在这里保留：
// main.auditMaterialBalances("UNLOAD_BEGIN truck=" + t.truckId);

// 下一辆必须根据本车预约后的容量重新判断。
tryAdmitDumpTruck();]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;

numInDumpService = Math.max(0, numInDumpService - 1);

t.dumpServiceEndTime = time(MINUTE);

double serviceTime = t.dumpServiceEndTime - t.dumpServiceStartTime;
if (serviceTime < 0) serviceTime = 0;

totalDumpServiceTime += serviceTime;

/*traceln("Truck " + t.truckId
    + " finishes dumping at " + siteName
    + ", dumpServiceTime=" + serviceTime
    + ", totalDumpServiceTime=" + totalDumpServiceTime
    + ", dumping=" + numInDumpService);*/]]></Code>
							</Value>
						</Parameter>
