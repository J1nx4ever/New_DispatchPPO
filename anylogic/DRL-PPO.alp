		<JavaClass>
			<Id>1782716443253</Id>
			<Name><![CDATA[PathSegment]]></Name>
			<Text><![CDATA[ import fusion.Main;

public class PathSegment {
    public Main main;
    public String key;
    public String physicalKey;
    public String from;
    public String to;
    public String positiveFrom;
    public String positiveTo;
    public double length;
    public int direction;
    public String directionName;
    public double speedLimit;
    public boolean closed;

    // 唯一构造函数，包含所有参数
    public PathSegment(
        Main main,
        String from,
        String to,
        String positiveFrom,
        String positiveTo,
        double speedLimit
    ) {
        this.main = main;
        this.from = from;
        this.to = to;
        this.positiveFrom = positiveFrom;
        this.positiveTo = positiveTo;
        this.speedLimit = speedLimit;
        this.closed = false;
        
        this.key = from + "_" + to;
        this.physicalKey = makePhysicalKey(positiveFrom, positiveTo);

        if (from.equals(positiveFrom) && to.equals(positiveTo)) {
            this.direction = 1;
            this.directionName = "TO_LOAD";
        } else {
            this.direction = -1;
            this.directionName = "TO_DUMP";
        }
        calculateLength();

    }

    public String makePhysicalKey(String a, String b) {
        return a + "__" + b;
    }

    public void calculateLength() {
        if (main != null) {
            this.length = main.getNodesPosition(
                main.getRoadPointNode(this.positiveFrom),
                main.getRoadPointNode(this.positiveTo)
            );
        } else {
            traceln("警告：main 为 null，无法计算长度");
            this.length = 0;
        }
    }
    // =========================
    // Lane / direction utilities
    // =========================

    public String getLaneKey() {
        return physicalKey + "_" + direction;
    }

    public boolean isSamePhysicalSegment(PathSegment other) {
        if (other == null) {
            return false;
        }

        if (this.physicalKey == null || other.physicalKey == null) {
            return false;
        }

        return this.physicalKey.equals(other.physicalKey);
    }

    public boolean isSameDirectedSegment(PathSegment other) {
        if (other == null) {
            return false;
        }

        if (!isSamePhysicalSegment(other)) {
            return false;
        }

        return this.direction == other.direction;
    }

    public boolean isSameLane(PathSegment other) {
        return isSameDirectedSegment(other);
    }

    /**
     * Convert remaining distance to the next node/intersection into directed progress
     * on this segment.
     *
     * Assumption:
     *   disToInt means the remaining distance from the truck to the downstream node
     *   along this segment's current driving direction.
     *
     * Then:
     *   progress = length - disToInt
     *
     * Larger progress means the truck is further ahead on this directed segment.
     */
    public double calcProgressFromRemainingDistance(double disToInt) {
        if (Double.isNaN(disToInt) || Double.isInfinite(disToInt)) {
            return 0;
        }

        double progress = length - disToInt;

        if (progress < 0) {
            progress = 0;
        }

        if (progress > length) {
            progress = length;
        }

        return progress;
    }

    /**
     * Returns progress difference from ego to other:
     *
     *   gap > 0  : other is ahead of ego
     *   gap < 0  : other is behind ego
     *   NaN      : not on the same directed segment
     */
    public double calcProgressGap(
        double egoDisToInt,
        PathSegment otherSegment,
        double otherDisToInt
    ) {
        if (!isSameDirectedSegment(otherSegment)) {
            return Double.NaN;
        }

        double egoProgress = calcProgressFromRemainingDistance(egoDisToInt);
        double otherProgress = otherSegment.calcProgressFromRemainingDistance(otherDisToInt);

        return otherProgress - egoProgress;
    }

    public boolean isAhead(
        double egoDisToInt,
        PathSegment otherSegment,
        double otherDisToInt
    ) {
        double gap = calcProgressGap(egoDisToInt, otherSegment, otherDisToInt);

        if (Double.isNaN(gap)) {
            return false;
        }

        return gap > 0;
    }

    public boolean isBehind(
        double egoDisToInt,
        PathSegment otherSegment,
        double otherDisToInt
    ) {
        double gap = calcProgressGap(egoDisToInt, otherSegment, otherDisToInt);

        if (Double.isNaN(gap)) {
            return false;
        }

        return gap < 0;
    }
    public static double calcRouteProgress(
    	    java.util.ArrayList<PathSegment> routeSegments,
    	    PathSegment currentSegment,
    	    double disToInt
    	) {
    	    if (routeSegments == null || currentSegment == null) {
    	        return 0;
    	    }

    	    double progress = 0;

    	    for (PathSegment seg : routeSegments) {

    	        if (seg == null) {
    	            continue;
    	        }

    	        boolean isCurrent = false;

    	        if (seg.key != null && currentSegment.key != null) {
    	            isCurrent = seg.key.equals(currentSegment.key);
    	        } else if (seg.physicalKey != null && currentSegment.physicalKey != null) {
    	            isCurrent =
    	                seg.physicalKey.equals(currentSegment.physicalKey)
    	                && seg.direction == currentSegment.direction;
    	        }

    	        if (isCurrent) {
    	            progress += currentSegment.calcProgressFromRemainingDistance(disToInt);
    	            return progress;
    	        } else {
    	            progress += seg.length;
    	        }
    	    }

    	    return progress;
    	}
    public String getDirectedFrom() {
        return from;
    }

    public String getDirectedTo() {
        return to;
    }
}]]></Text>
		</JavaClass>
