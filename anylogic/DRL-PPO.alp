				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783067303037</Id>
					<Name><![CDATA[destinationToInt]]></Name>
					<X>-250</X><Y>-370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[destination]]></Name>
						<Type><![CDATA[PointNode]]></Type>
					</Parameter>
					<Body><![CDATA[int  intDestination = 0;

if(destination == intersection1) intDestination = 1;
if(destination == intersection2) intDestination = 2;
if(destination == intersection3) intDestination = 3;
if(destination == ShovelOreLow) intDestination = 4;
if(destination == ShovelOreHigh2) intDestination = 5;
if(destination == ShovelOreHigh1) intDestination = 6;
if(destination == ShovelWaste) intDestination = 7;
if(destination == Crusher) intDestination = 8;
if(destination == dumpNode) intDestination = 9;

return intDestination;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783159110256</Id>
					<Name><![CDATA[roadNodeNameToInt]]></Name>
					<X>-250</X><Y>-330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nodeName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[
if (nodeName == null) return 0;

if (nodeName.equals("intersection1")) return 1;
if (nodeName.equals("intersection2")) return 2;
if (nodeName.equals("intersection3")) return 3;

if (nodeName.equals("ShovelOreLow")) return 4;
if (nodeName.equals("ShovelOreHigh2")) return 5;
if (nodeName.equals("ShovelOreHigh1")) return 6;
if (nodeName.equals("ShovelWaste")) return 7;

if (nodeName.equals("Crusher")) return 8;
if (nodeName.equals("dumpNode")) return 9;

return 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.EnvInfoDict]]></ReturnType>
					<Id>1783323717940</Id>
					<Name><![CDATA[get_info]]></Name>
					<X>1280</X><Y>-880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Fusion.grpc.EnvInfoDict.Builder infoBuilder =
    Fusion.grpc.EnvInfoDict.newBuilder();

for (Truck t : trucks) {
    Fusion.grpc.TruckInfo info =
        Fusion.grpc.TruckInfo.newBuilder()
            .setAgentId("agent_" + t.truckId)
            .setFuelConsumption(0)
            .setDistanceTraveled(0)
            .setTriggerType("speed_control")
            .setEventName("speed_step")
            .build();

    infoBuilder.addInfos(info);
}

return infoBuilder.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783323736821</Id>
					<Name><![CDATA[applySpeedActions]]></Name>
					<X>1280</X><Y>-840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[request]]></Name>
						<Type><![CDATA[Fusion.grpc.ActionDict ]]></Type>
					</Parameter>
					<Body><![CDATA[if (request == null) {
    traceln(
        "[SpeedControl] applySpeedActions: request is null"
    );
    return;
}

/*
 * 当前模型时间单位为Second。
 * 控制周期固定为0.1秒。
 */
final double dtSeconds = 0.1;

// ONNX输出已经映射成物理加速度
final double minAcceleration = -3.0;
final double maxAcceleration = 2.0;

// 车辆速度限制，单位m/s
final double minSpeed = 1e-6;
final double maxSpeed = 15.0;

/*
 * 防止同一个ActionDict中同一辆车出现多条动作。
 */
java.util.HashSet<Integer> processedTruckIds =
    new java.util.HashSet<Integer>();

for (
    Fusion.grpc.Action action :
    request.getActionsList()
) {
    if (action == null) {
        continue;
    }

    String agentId = action.getAgentId();

    if (
        agentId == null
        || agentId.trim().length() == 0
    ) {
        traceln(
            "[SpeedControl] Empty agent_id ignored"
        );
        continue;
    }

    if (action.getActionCount() == 0) {
        traceln(
            "[SpeedControl] Empty action ignored for "
            + agentId
        );
        continue;
    }

    /*
     * 支持以下agent_id：
     *
     * agent_10
     * agent_10.0
     * 10
     */
    String idText = agentId.trim();

    if (idText.startsWith("agent_")) {
        idText =
            idText.substring("agent_".length());
    }

    if (idText.endsWith(".0")) {
        idText =
            idText.substring(
                0,
                idText.length() - 2
            );
    }

    int requestedTruckId;

    try {
        requestedTruckId =
            Integer.parseInt(idText);

    } catch (Exception e) {
        traceln(
            "[SpeedControl] Invalid agent_id ignored: "
            + agentId
        );
        continue;
    }

    if (
        processedTruckIds.contains(
            requestedTruckId
        )
    ) {
        traceln(
            "[SpeedControl] Duplicate action ignored: "
            + agentId
        );
        continue;
    }

    double acceleration =
        action.getAction(0);

    if (
        Double.isNaN(acceleration)
        || Double.isInfinite(acceleration)
    ) {
        traceln(
            "[SpeedControl] Invalid acceleration ignored"
            + ", agent=" + agentId
            + ", acceleration=" + acceleration
        );
        continue;
    }

    /*
     * Python端已经完成：
     *
     * action >= 0 → action × 2
     * action < 0  → action × 3
     *
     * 因此AnyLogic端不能再次乘2或乘3，
     * 这里只进行安全裁剪。
     */
    acceleration =
        Math.max(
            minAcceleration,
            Math.min(
                maxAcceleration,
                acceleration
            )
        );

    /*
     * 根据truckId查找车辆。
     *
     * 不使用trucks.get(truckId)，因为动态车辆数量
     * 或删除车辆后，集合下标可能不等于truckId。
     */
    Truck targetTruck = null;

    for (Truck truck : trucks) {
        if (
            truck != null
            && truck.truckId == requestedTruckId
        ) {
            targetTruck = truck;
            break;
        }
    }

    if (targetTruck == null) {
        traceln(
            "[SpeedControl] Truck not found: "
            + agentId
        );
        continue;
    }

    Truck t = targetTruck;

    double currentSpeed;

    try {
        currentSpeed = t.getSpeed();

    } catch (Throwable e) {
        currentSpeed = t.egoSpeed;
    }

    if (
        Double.isNaN(currentSpeed)
        || Double.isInfinite(currentSpeed)
        || currentSpeed < 0
    ) {
        if (
            !Double.isNaN(t.egoSpeed)
            && !Double.isInfinite(t.egoSpeed)
            && t.egoSpeed >= 0
        ) {
            currentSpeed = t.egoSpeed;
        } else {
            currentSpeed = 0.0;
        }
    }

    double oldCmdAccel = t.cmdAccel;
    double oldPrevCmdAccel = t.prevCmdAccel;

    /*
     * 保存动作历史。
     */
    t.prevCmdAccel = t.cmdAccel;
    t.cmdAccel = acceleration;

    /*
     * 离散速度积分：
     *
     * v(t+0.1) = v(t) + a(t) × 0.1
     */
    double newSpeed =
        currentSpeed
        + acceleration * dtSeconds;

    newSpeed =
        Math.max(
            minSpeed,
            Math.min(maxSpeed, newSpeed)
        );

    boolean speedApplied = false;

    try {
        /*
         * Truck继承AnyLogic Agent。
         * 明确使用MPS，即米/秒。
         */
        t.setSpeed(newSpeed, MPS);
        speedApplied = true;

    } catch (Throwable firstError) {
        try {
            /*
             * 兼容不带单位的setSpeed重载。
             * 默认单位同样是m/s。
             */
            t.setSpeed(newSpeed);
            speedApplied = true;

        } catch (Throwable secondError) {
            traceln(
                "[SpeedControl] setSpeed failed"
                + ", truck=" + requestedTruckId
                + ", error="
                + secondError.getMessage()
            );
        }
    }

    if (speedApplied) {
        /*
         * 保证用于observation的缓存速度立即同步。
         */
        t.egoSpeed = newSpeed;

        processedTruckIds.add(
            requestedTruckId
        );

        traceln(
            "[SpeedControl] Applied"
            + ", truck=" + requestedTruckId
            + ", oldSpeed=" + currentSpeed
            + ", acceleration=" + acceleration
            + ", newSpeed=" + newSpeed
        );

    } else {
        /*
         * setSpeed失败时回滚动作状态，
         * 防止observation显示未实际执行的动作。
         */
        t.cmdAccel = oldCmdAccel;
        t.prevCmdAccel = oldPrevCmdAccel;
    }
}]]></Body>
				</Function>
