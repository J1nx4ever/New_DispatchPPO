				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.ObservationDict]]></ReturnType>
					<Id>1783325312692</Id>
					<Name><![CDATA[get_all_observations]]></Name>
					<X>1520</X><Y>-760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return buildSpeedObservations(3);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783325699082</Id>
					<Name><![CDATA[updateFrontRearVehicles]]></Name>
					<X>1520</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ================================
// updateFrontRearVehicles()
// 功能：
// 1. 按有向路段分组
// 2. 组内按 laneProgress 排序
// 3. 识别每辆车的前车、后车
// 4. 输出每条路段车辆数量、首车、尾车
// ================================

// 是否打印详细调试信息
boolean debugFrontRear = false;

// 1. 清空所有车辆前后车状态
for (Truck t : trucks) {
    t.hasFront = false;
    t.front_id = -1;
    t.frontSpeed = 0;
    t.frontDis = 9999;
    t.frontTtc = 9999;

    t.hasRear = false;
    t.rear_id = -1;
    t.rearSpeed = 0;
    t.rearDis = 9999;

    t.currentLaneKey = "";
    t.currentDirection = 0;
    t.laneProgress = 0;
}

// 2. 按有向路段 laneKey 分组
java.util.HashMap<String, java.util.ArrayList<Truck>> laneGroups =
    new java.util.HashMap<String, java.util.ArrayList<Truck>>();

for (Truck t : trucks) {

    // 跳过未进入有效路段的车辆
    if (t.currentSegment == null) {
        if (debugFrontRear) {
            traceln(
                "[FrontRear] truck=" + t.truckId
                + " currentSegment=null, skipped."
            );
        }
        continue;
    }

    // 生成有向路段 key，例如 physicalKey_direction
    String laneKey = t.currentSegment.getLaneKey();

    t.currentLaneKey = laneKey;
    t.currentDirection = t.currentSegment.direction;

    // 计算车辆在当前有向路段上的进度
    // 假设 disToInt 表示到下游目标点的剩余距离
    t.laneProgress =
        t.currentSegment.calcProgressFromRemainingDistance(t.disToInt);

    if (!laneGroups.containsKey(laneKey)) {
        laneGroups.put(laneKey, new java.util.ArrayList<Truck>());
    }

    laneGroups.get(laneKey).add(t);
}

// 3. 如果当前没有任何有效路段车辆
if (laneGroups.size() == 0) {
    if (debugFrontRear) {
        traceln("[FrontRear] No trucks on valid directed segments.");
    }
    return;
}

// 4. 遍历每条有向路段，排序并识别前后车
for (String laneKey : laneGroups.keySet()) {

    java.util.ArrayList<Truck> list = laneGroups.get(laneKey);

    if (list == null || list.size() == 0) {
        continue;
    }

    // 按 laneProgress 从小到大排序
    // 小：靠后；大：靠前
	java.util.Collections.sort(list, new java.util.Comparator<Truck>() {
	    @Override
	    public int compare(Truck a, Truck b) {
	
	        // 后进入路段的车辆在后方，排在列表前面；
	        // 先进入的车辆在前方，排在列表后面。
	        int result =
	            Long.compare(b.laneEntrySeq, a.laneEntrySeq);
	
	        if (result != 0) {
	            return result;
	        }
	
	        // 极少数完全同时进入的情况，用 truckId 保证顺序稳定。
	        return Integer.compare(b.truckId, a.truckId);
	    }
	});

    int count = list.size();

    Truck tailTruck = list.get(0);              // laneProgress 最小，尾车
    Truck headTruck = list.get(count - 1);      // laneProgress 最大，首车

    // 5. 输出该路段基本信息
    if (debugFrontRear) {
        String segmentInfo = "";

        try {
            PathSegment seg = headTruck.currentSegment;
            segmentInfo =
                "physicalKey=" + seg.physicalKey
                + ", key=" + seg.key
                + ", direction=" + seg.direction
                + ", from=" + seg.from
                + ", to=" + seg.to
                + ", length=" + seg.length;
        } catch (Exception e) {
            segmentInfo = "segmentInfo unavailable";
        }

        traceln("--------------------------------------------------");
        traceln(
            "[LaneSummary] laneKey=" + laneKey
            + ", truckCount=" + count
            + ", headTruck=" + headTruck.truckId
            + ", tailTruck=" + tailTruck.truckId
        );
        traceln("[LaneSummary] " + segmentInfo);
    }

    // 6. 逐车识别前车、后车
    for (int i = 0; i < count; i++) {

        Truck ego = list.get(i);

        Truck rear = null;
        Truck front = null;

        // 排序后，i-1 是后车，i+1 是前车
        if (i > 0) {
            rear = list.get(i - 1);
        }

        if (i < count - 1) {
            front = list.get(i + 1);
        }

        // ---------- 写入前车 ----------
        if (front != null) {

            ego.hasFront = true;
            ego.front_id = front.truckId;
            ego.frontSpeed = front.egoSpeed;
			double dx =
			    front.getX() - ego.getX();
			
			double dy =
			    front.getY() - ego.getY();
			
			double d = toLengthUnits(
			    Math.sqrt(dx * dx + dy * dy),
			    METER
			);
			
			if (!Double.isFinite(d)) {
			    d = 9999;
			}

            ego.frontDis = d;

            double relSpeed = ego.egoSpeed - front.egoSpeed;

            if (relSpeed > 0.1) {
                ego.frontTtc = d / relSpeed;
            } else {
                ego.frontTtc = 9999;
            }

        } else {
            // 当前车是首车，没有前车
            ego.hasFront = false;
            ego.front_id = -1;
            ego.frontSpeed = 0;
            ego.frontDis = 9999;
            ego.frontTtc = 9999;
        }

        // ---------- 写入后车 ----------
        if (rear != null) {

            ego.hasRear = true;
            ego.rear_id = rear.truckId;
            ego.rearSpeed = rear.egoSpeed;

            double d = 9999;

            try {
                d = DistanceRecorder(
                    ego.getX(), ego.getY(),
                    rear.getX(), rear.getY()
                );
            } catch (Exception e) {
                // DistanceRecorder 失败时，用 progress 差兜底
                d = Math.abs(ego.laneProgress - rear.laneProgress);
            }

            ego.rearDis = d;

        } else {
            // 当前车是尾车，没有后车
            ego.hasRear = false;
            ego.rear_id = -1;
            ego.rearSpeed = 0;
            ego.rearDis = 9999;
        }

        // 7. 输出该车跟驰状态
        if (debugFrontRear) {

            String role = "middle";

            if (ego == headTruck && ego == tailTruck) {
                role = "single";
            } else if (ego == headTruck) {
                role = "head";
            } else if (ego == tailTruck) {
                role = "tail";
            }

            traceln(
                "[LaneTruck] laneKey=" + laneKey
                + ", role=" + role
                + ", truck=" + ego.truckId
                + ", progress=" + ego.laneProgress
                + ", disToInt=" + ego.disToInt
                + ", speed=" + ego.egoSpeed
                + ", hasFront=" + ego.hasFront
                + ", frontId=" + ego.front_id
                + ", frontDis=" + ego.frontDis
                + ", frontTtc=" + ego.frontTtc
                + ", hasRear=" + ego.hasRear
                + ", rearId=" + ego.rear_id
                + ", rearDis=" + ego.rearDis
            );
        }
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783325721757</Id>
					<Name><![CDATA[updateConflictVehicles]]></Name>
					<X>1520</X><Y>-680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ================================
// updateConflictVehicles()
// 第三阶段：交叉点/下游节点冲突车计算
//
// 当前定义：
// 两车即将到达同一个下游节点，并且 ETA 接近，认为存在冲突。
// 不考虑合流前车、不考虑路径合流，只传 proto 中 conflict_vehicles。
// ================================

boolean debugConflict = false;

double conflictEtaThreshold = 6.0;       // 秒，ETA差小于该值认为可能冲突
double conflictLookAheadDist = 150.0;    // 米，只考虑距离下游节点一定范围内的车

// 1. 清空所有车辆冲突状态
for (Truck t : trucks) {
    clearConflictState(t);
}

// 2. 预先计算每辆车的冲突节点、距离、ETA
java.util.HashMap<Truck, String> nodeMap =
    new java.util.HashMap<Truck, String>();

java.util.HashMap<Truck, Double> distMap =
    new java.util.HashMap<Truck, Double>();

java.util.HashMap<Truck, Double> etaMap =
    new java.util.HashMap<Truck, Double>();

for (Truck t : trucks) {

    String nodeKey = getTruckConflictNodeKey(t);

    if (nodeKey == null || nodeKey.length() == 0) {
        continue;
    }

    double dist = calcDistanceToNode(t, nodeKey);

    double speed = 0;

    try {
        speed = t.egoSpeed;
    } catch (Exception e) {
        try {
            speed = t.getSpeed();
        } catch (Exception ex) {
            speed = 0;
        }
    }

    double eta = calcEta(dist, speed);

    t.conflictNodeKey = nodeKey;
    t.egoConflictDist = dist;
    t.egoConflictEta = eta;

    nodeMap.put(t, nodeKey);
    distMap.put(t, dist);
    etaMap.put(t, eta);

    if (debugConflict) {
        traceln(
            "[ConflictBase] truck=" + t.truckId
            + ", node=" + nodeKey
            + ", dist=" + dist
            + ", speed=" + speed
            + ", eta=" + eta
        );
    }
}

// 3. 两两比较车辆是否冲突
for (Truck ego : trucks) {

    if (!nodeMap.containsKey(ego)) {
        continue;
    }

    String egoNode = nodeMap.get(ego);
    double egoDist = distMap.get(ego);
    double egoEta = etaMap.get(ego);

    if (egoDist > conflictLookAheadDist) {
        continue;
    }

    if (egoEta >= 9999) {
        continue;
    }

    for (Truck other : trucks) {

        if (ego == other) {
            continue;
        }

        if (!nodeMap.containsKey(other)) {
            continue;
        }

        String otherNode = nodeMap.get(other);

        // 只看同一个下游节点/交叉点
        if (!egoNode.equals(otherNode)) {
            continue;
        }

        double otherDist = distMap.get(other);
        double otherEta = etaMap.get(other);

        if (otherDist > conflictLookAheadDist) {
            continue;
        }

        if (otherEta >= 9999) {
            continue;
        }

        double diffEta = Math.abs(egoEta - otherEta);

        if (diffEta > conflictEtaThreshold) {
            continue;
        }

        // 如果两车已经在同一有向路段，通常由 front/rear 处理，不作为交叉冲突
        boolean sameDirectedSegment = false;

        try {
            sameDirectedSegment =
                ego.currentSegment != null
                && other.currentSegment != null
                && ego.currentSegment.isSameDirectedSegment(other.currentSegment);
        } catch (Exception e) {
            sameDirectedSegment = false;
        }

        if (sameDirectedSegment) {
            continue;
        }

        // 4. 写入 ego 的冲突车辆列表
        ego.conflict_id.add(other.truckId);
        ego.conflictSpeed.add((float) other.egoSpeed);
        ego.conflictEta.add((float) otherEta);
        ego.conflictDist.add((float) otherDist);

        if (debugConflict) {
            traceln(
                "[ConflictVehicle] ego=" + ego.truckId
                + ", other=" + other.truckId
                + ", node=" + egoNode
                + ", egoEta=" + egoEta
                + ", otherEta=" + otherEta
                + ", diffEta=" + diffEta
                + ", otherDist=" + otherDist
            );
        }
    }
}]]></Body>
				</Function>
