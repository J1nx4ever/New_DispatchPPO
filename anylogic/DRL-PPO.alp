				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782802968408</Id>
					<Name><![CDATA[prepareRoute]]></Name>
					<X>1560</X><Y>610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[start]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destination]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[currentNode = start;
destinationNode = destination;
currentRouteNodes = main.routeNodeMap.get(start + "_" + destination);
currentRouteSegments = main.getRouteSegments(start, destination);
currentRouteKey = start + "_" + destination;
if (currentRouteNodes == null || currentRouteSegments == null || currentRouteSegments.size() == 0) {
    //traceln("Truck " + truckId + " route not found: " + start + " -> " + destination);
    return;
}

currentSegmentIndex = 0;
currentSegment = currentRouteSegments.get(currentSegmentIndex);
laneEntrySeq = main.nextLaneEntrySeq++;

// 当前方向由 PathSegment 给 Truck
direction = currentSegment.direction;
//traceln("当前的方向是: " + direction);

// 当前节点和目标节点编号
currentNodeId = main.destinationToInt(main.getRoadPointNode(currentNode));
targetNodeName = currentSegment.to;
targetNodeId = main.destinationToInt(main.getRoadPointNode(targetNodeName));

// 当前路段长度与距离
remainingDistanceOnSegment = currentSegment.length;
remainingDistanceToDestination = calculateDisToDes();

// 记录当前路段起点和终点坐标

/*traceln("Truck " + truckId + " route prepared: " 
    + start + " -> " + destination 
    + ", first segment: " + currentSegment.from + " -> " + currentSegment.to);
    */]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783068232576</Id>
					<Name><![CDATA[calculateDisOnSeg]]></Name>
					<X>1680</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (targetNodeName == null || targetNodeName.isEmpty()) {
    return 0.0;
}

PointNode targetNode = main.getRoadPointNode(targetNodeName);

if (targetNode == null) {
    throw new IllegalStateException(
        "Target node not found: " + targetNodeName
    );
}

Point currentPos = new Point(getX(), getY());
Point targetPos = new Point(targetNode.getX(), targetNode.getY());

ContinuousShortestPathData out = new ContinuousShortestPathData();
main.network.getPathData(currentPos, targetPos, out);

return main.toLengthUnits(out.distance, METER);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783069578929</Id>
					<Name><![CDATA[calculateDisToDes]]></Name>
					<X>1690</X><Y>930</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/*
if (currentSegment == null || currentRouteSegments == null || currentRouteSegments.size() == 0) {
    return 0;
}
*/
double total = remainingDistanceOnSegment;

for (int i = currentSegmentIndex + 1; i < currentRouteSegments.size(); i++) {
    total += currentRouteSegments.get(i).length;
}

return total;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783308773366</Id>
					<Name><![CDATA[calcTTA]]></Name>
					<X>1180</X><Y>820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[dist]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[speed]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (dist <= 0) {
    return 0;
}

if (speed <= minSpeedForTTA) {
    return maxTTA;
}

return dist / speed;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783321689250</Id>
					<Name><![CDATA[updateBasicSpeedState]]></Name>
					<X>1100</X><Y>1020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    egoSpeed = getSpeed();
} catch (Exception e) {
    egoSpeed = 0;
}

try {
    disToInt = calculateDisOnSeg();
} catch (Exception e) {
    disToInt = 0;
}

tta = calcTTA(disToInt, egoSpeed);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783906367599</Id>
					<Name><![CDATA[onLoadingFinished]]></Name>
					<X>130</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ls]]></Name>
						<Type><![CDATA[LoadSite]]></Type>
					</Parameter>
					<Body><![CDATA[if (time(SECOND) >= main.rlShiftSeconds) return;
if (ls == null || ls != targetShovel) {
    throw new IllegalStateException("Invalid loading site, truck=" + truckId);
}
double loadedTons = ls.completeLoading(this);
payloadTons = loadedTons;
payloadIsOre = ls.isOre;
// payloadGrade 已在 LoadSite.delay 开始服务时确定，不再覆盖。
plannedPayloadTons = 0.0;
isLoaded = true;
loadFinishedFlag = true;
hasEnteredCurrentProcess = false;
currentLoadSiteId = ls.siteId;
currentNode = destinationNode;

main.auditMaterialBalances("LOAD_DONE truck=" + truckId);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783927117311</Id>
					<Name><![CDATA[onDumpingFinished]]></Name>
					<X>-20</X><Y>1280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ds]]></Name>
						<Type><![CDATA[DumpSite]]></Type>
					</Parameter>
					<Body><![CDATA[if (time(SECOND) >= main.rlShiftSeconds) return;
if (ds == null) throw new IllegalStateException("Missing dump site");
ds.completeUnloading(this);
targetDump = ds;
currentDumpSiteId = ds.siteId;
dumpFinishTime = time(MINUTE);
dumpFinishedFlag = true;
hasEnteredCurrentProcess = false;
isLoaded = false;
payloadIsOre = false;
payloadGrade = 0.0;
payloadTons = 0.0;
executionPhase = "COMPLETED";
setTruckIdle(true);
if (currentLegToSiteId != null && !currentLegToSiteId.isBlank()) {
    currentBusinessSiteId = currentLegToSiteId;
}
nextSiteId = null;
debugLastAction = "FinishDump";
currentNode = destinationNode;

main.auditMaterialBalances("DUMP_DONE truck=" + truckId);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792499998536</Id>
					<Name><![CDATA[setTruckIdle]]></Name>
					<X>1260</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idle]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[double nowSec = Math.max(
    0.0,
    Math.min(time(SECOND), main.rlShiftSeconds)
);

// 相同状态重复调用，不重复计时。
if (idle == truckIdleNow) return;

if (truckIdleNow) {
    truckIdleAccumSec += Math.max(
        0.0,
        nowSec - truckIdleStartSec
    );
}

truckIdleNow = idle;
truckIdleStartSec = nowSec;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792500017953</Id>
					<Name><![CDATA[getTruckIdleSeconds]]></Name>
					<X>1260</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double nowSec = Math.max(
    0.0,
    Math.min(time(SECOND), main.rlShiftSeconds)
);

return truckIdleAccumSec
    + (truckIdleNow
        ? Math.max(0.0, nowSec - truckIdleStartSec)
        : 0.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578602894</Id>
					<Name><![CDATA[obsResetMotion]]></Name>
					<X>2220</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[obsMotionSamples.clear();
obsLastMotionSec=-1.0;
obsFreeCount=0L;
obsFreeMean=0.0;
obsFreeM2=0.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578620871</Id>
					<Name><![CDATA[obsRecordMotion]]></Name>
					<X>2220</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[boolean moving="TO_LOAD".equals(executionPhase)||"TO_DUMP".equals(executionPhase);
double now=time(SECOND);
if(!moving || currentSegment==null || now<=obsLastMotionSec+1e-9) return;
double v=getSpeed();
double gap=hasFront?frontDis:0.0;
double fv=hasFront?frontSpeed:0.0;
obsMotionSamples.addLast(new double[]{now,v,dynamicAccel,hasFront?1.0:0.0,gap,fv});
while(obsMotionSamples.size()>4) obsMotionSamples.removeFirst();
obsLastMotionSec=now;
// Observable near-steady free-flow speed ratio; this is an estimate, not the hidden draw.
if((!hasFront || frontDis>=main.followRangeM) && Math.abs(dynamicAccel)<0.05) {
    double vehicleKph=isLoaded?(truckType==0?20:truckType==1?18:16):(truckType==0?26:truckType==1?24:22);
    double base=main.getBaseSpeedMps(currentSegment,isLoaded)*vehicleKph/(isLoaded?20.0:26.0);
    if(base>1e-9) {
        double ratio=v/base;
        obsFreeCount++;
        double delta=ratio-obsFreeMean;
        obsFreeMean+=delta/obsFreeCount;
        obsFreeM2+=delta*(ratio-obsFreeMean);
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578634149</Id>
					<Name><![CDATA[appendDispatchObservation]]></Name>
					<X>2220</X><Y>680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[w]]></Name>
						<Type><![CDATA[DispatchObsWriter]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[ego]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[String p="truck."+truckId+".";
double now=time(SECOND);
boolean decision=this==ego;
boolean loading=!isLoaded && "LOADING".equals(executionPhase);
boolean dumping=isLoaded && "DUMPING".equals(executionPhase);
boolean moving=("TO_LOAD".equals(executionPhase)||"TO_DUMP".equals(executionPhase)) && !decision;
int dumpWaitStage=0;
for(DumpSite ds:main.dumpSites) {
    if(ds.dumpCapacityWaitOrder.contains(this)) dumpWaitStage=2;
    if(ds.obsAdmissionTruck==this) dumpWaitStage=3;
}
if(dumpWaitStage==0 && isWaitingForDumpResource) dumpWaitStage=1;
int phase=11;
if(decision) phase=0;
else if(!initialDispatchDone) phase=1;
else if("TO_LOAD".equals(executionPhase)) phase=2;
else if(isWaitingForLoadResource) phase=3;
else if(loading) phase=4;
else if("TO_DUMP".equals(executionPhase)) phase=5;
else if(dumpWaitStage==1) phase=6;
else if(dumpWaitStage==2) phase=7;
else if(dumpWaitStage==3) phase=8;
else if(dumping) phase=9;
else if("COMPLETED".equals(executionPhase)||"NO_AVAILABLE_MATERIAL".equals(executionPhase)) phase=10;
w.add(p+"ego",decision?1:0);
w.oneHot(p+"type.",truckType,3);
w.oneHot(p+"phase.",phase,12);
w.add(p+"capacity",capacity/193.0);
w.add(p+"loaded",isLoaded?1:0);
w.add(p+"ore",isLoaded?(payloadIsOre?1:0):(plannedPayloadTons>0 && targetShovel!=null && targetShovel.isOre?1:0));
w.add(p+"payloadTons",payloadTons/193.0);
w.add(p+"reservedLoadTons",plannedPayloadTons/193.0);
w.add(p+"gradeKnown",isLoaded?1:0);
w.add(p+"payloadGrade",isLoaded?payloadGrade:0.0);
double[] gs=loading?targetShovel.obsGradeStats(obsLoadMaterialStart,plannedPayloadTons):new double[]{0,0,0};
w.add(p+"loadingGradeMean",gs[0]);
w.add(p+"loadingGradeStd",gs[1]);
w.add(p+"loadingGradeInferred",gs[2]);
w.oneHot(p+"loadTarget.",!decision && plannedPayloadTons>0 && targetShovel!=null?targetShovel.siteId:-1,4);
w.oneHot(p+"dumpTarget.",isLoaded?(payloadIsOre?0:1):-1,2);
w.oneHot(p+"node.",main.obsNodeIndex(currentNode),9);
w.add(p+"xM",main.toLengthUnits(getX(),METER)/10000.0);
w.add(p+"yM",main.toLengthUnits(getY(),METER)/10000.0);
w.add(p+"speed",getSpeed()/10.0);
w.add(p+"acceleration",dynamicAccel/3.0);
int seg=moving?main.obsSegmentIndex(currentSegment):-1;
w.oneHot(p+"segment.",seg,16);
double remaining=seg>=0?calculateDisOnSeg():0.0;
w.add(p+"segmentRemaining",remaining/10000.0);
double totalRemaining=remaining;
double[] routeOrder=new double[16];
if(seg>=0) {
    for(int j=currentSegmentIndex;j<currentRouteSegments.size();j++) {
        PathSegment rs=currentRouteSegments.get(j);
        int ri=main.obsSegmentIndex(rs);
        if(routeOrder[ri]!=0) throw new IllegalStateException("Route repeats a segment; change encoding");
        routeOrder[ri]=(j-currentSegmentIndex+1.0)/16.0;
        if(j>currentSegmentIndex) totalRemaining+=rs.length;
    }
}
w.add(p+"routeRemaining",totalRemaining/10000.0);
for(int i=0;i<16;i++) w.add(p+"routeOrder."+i,routeOrder[i]);
int ahead=0;
if(seg>=0) for(Truck other:main.trucks) {
    if(other!=this && other.currentSegment!=null && currentSegment.key.equals(other.currentSegment.key)
        && (other.laneEntrySeq<laneEntrySeq || (other.laneEntrySeq==laneEntrySeq && other.truckId<truckId))) ahead++;
}
w.add(p+"laneRank",seg>=0?(ahead+1.0)/9.0:0.0);
w.add(p+"initialDispatched",initialDispatchDone?1:0);
w.add(p+"initialPredecessor",initialPredecessor==null?0:(initialPredecessor.truckId+1.0)/9.0);
w.add(p+"loadWaitAge",isWaitingForLoadResource?Math.max(0.0,now-60.0*queueEnterTime)/28800.0:0.0);
w.add(p+"dumpWaitAge",isWaitingForDumpResource?Math.max(0.0,now-60.0*dumpQueueEnterTime)/28800.0:0.0);
w.add(p+"loadAge",loading?Math.max(0.0,now-60.0*loadStartTime)/600.0:0.0);
w.add(p+"loadMean",loading?targetShovel.obsMeanLoadMinutes(plannedPayloadTons)/10.0:0.0);
w.add(p+"loadMaterialStart",loading?obsLoadMaterialStart/30000.0:0.0);
w.add(p+"dumpAge",dumping?Math.max(0.0,now-60.0*dumpServiceStartTime)/600.0:0.0);
w.add(p+"dumpMean",dumping?main.getDumpSiteById(targetDumpSiteId).obsMeanDumpMinutes(this)/10.0:0.0);
w.add(p+"freeSamples",obsFreeCount/1000.0);
w.add(p+"freeRatioMean",obsFreeCount>0?obsFreeMean:0.0);
w.add(p+"freeRatioStd",obsFreeCount>1?Math.sqrt(Math.max(0.0,obsFreeM2/(obsFreeCount-1))):0.0);
java.util.ArrayList<double[]> hist=new java.util.ArrayList<double[]>(obsMotionSamples);
for(int i=0;i<4;i++) {
    double[] h=i<hist.size()?hist.get(i):null;
    String hp=p+"motion."+i+".";
    w.add(hp+"valid",h==null?0:1);
    w.add(hp+"age",h==null?0:Math.max(0.0,now-h[0])/28800.0);
    w.add(hp+"speed",h==null?0:h[1]/10.0);
    w.add(hp+"acceleration",h==null?0:h[2]/3.0);
    w.add(hp+"hasFront",h==null?0:h[3]);
    w.add(hp+"frontGap",h==null?0:h[4]/10000.0);
    w.add(hp+"frontSpeed",h==null?0:h[5]/10.0);
}]]></Body>
				</Function>
			</Functions>
