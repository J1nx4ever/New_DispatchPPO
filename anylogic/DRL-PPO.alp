				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406477843</Id>
					<Name><![CDATA[getUtilization]]></Name>
					<X>20</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return Math.min(
    1.0,
    ((double) numInDumpService) / Math.max(1, serviceCapacity)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792419192434</Id>
					<Name><![CDATA[dumpServiceMinutes]]></Name>
					<X>740</X><Y>310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null || t.truckType < 0 || t.truckType > 2) {
    throw new IllegalArgumentException("Invalid truck type");
}
double mean;
if (acceptsOre) {
    mean = t.truckType == 0 ? 1.8 : t.truckType == 1 ? 2.0 : 2.3;
} else {
    mean = t.truckType == 0 ? 1.5 : t.truckType == 1 ? 1.7 : 2.0;
}
return mean * (main.deterministicCheck ? 1.0 : triangular(0.9, 1.0, 1.1));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792419369033</Id>
					<Name><![CDATA[canAcceptCrusher]]></Name>
					<X>740</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[return acceptsOre && t != null && t.isLoaded && t.payloadIsOre
    && t.payloadTons > 0.0 && time(SECOND) < main.rlShiftSeconds
    && crusherStoredTons + crusherReservedTons + t.payloadTons
        <= crusherBufferCapacityTons + 1e-6;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792419400267</Id>
					<Name><![CDATA[receiveCrusherBatch]]></Name>
					<X>740</X><Y>380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[double nowSec = time(SECOND);
if (nowSec >= main.rlShiftSeconds) return;
if (!acceptsOre || t == null || !t.payloadIsOre || !Double.isFinite(t.payloadTons)
    || t.payloadTons <= 0.0 || !Double.isFinite(t.payloadGrade)
    || t.payloadGrade < 0.0 || t.payloadGrade > 1.0) {
    throw new IllegalArgumentException("Invalid crusher batch");
}
// 先处理旧料到当前时刻，不能让新卸入的矿石被算作过去已经破碎。
advanceCrusherTo(nowSec);
if (crusherReservedTons + 1e-6 < t.payloadTons) {
    throw new IllegalStateException("Crusher reservation mismatch");
}
crusherReservedTons = Math.max(0.0, crusherReservedTons - t.payloadTons);
crusherFifo.addLast(new double[] { t.payloadTons, t.payloadGrade });
crusherStoredTons += t.payloadTons;
if (crusherStoredTons + crusherReservedTons > crusherBufferCapacityTons + 1e-6) {
    throw new IllegalStateException("Crusher buffer overflow");
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792419419003</Id>
					<Name><![CDATA[completeUnloading]]></Name>
					<X>740</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (time(SECOND) >= main.rlShiftSeconds) return;
if (t == null || !t.isLoaded || t.targetDumpSiteId != siteId
    || !Double.isFinite(t.payloadTons) || t.payloadTons <= 0.0) {
    throw new IllegalStateException("Invalid unloading task at " + siteName);
}
if (!Double.isFinite(t.payloadGrade) || t.payloadGrade < 0.0 || t.payloadGrade > 1.0
    || (!t.payloadIsOre && Math.abs(t.payloadGrade) > 1e-12)) {
    throw new IllegalStateException("Invalid unloading grade at " + siteName);
}
if (t.payloadIsOre && acceptsOre && siteId == 0) {
    receiveCrusherBatch(t);
} else if (!t.payloadIsOre && acceptsWaste) {
    main.recordWasteDelivery(t.payloadTons);
} else {
    throw new IllegalStateException("Material sent to wrong destination: " + siteName);
}
receivedTons += t.payloadTons;
if (t.payloadIsOre) receivedMetalTons += t.payloadTons * t.payloadGrade;
busy = false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792419537631</Id>
					<Name><![CDATA[advanceCrusherTo]]></Name>
					<X>740</X><Y>440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nowSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!acceptsOre) return;

if (!Double.isFinite(nowSec) || nowSec < 0.0) {
    throw new IllegalArgumentException("Invalid crusher time");
}

if (!Double.isFinite(crusherClockSec) || crusherClockSec < 0.0) {
    throw new IllegalStateException("Invalid crusher clock");
}

double endSec = Math.min(nowSec, main.rlShiftSeconds);

if (endSec <= crusherClockSec) return;

double rate = crusherRateTph / 3600.0;

if (!Double.isFinite(rate) || rate <= 0.0
    || !Double.isFinite(main.rlWindowSeconds)
    || main.rlWindowSeconds <= 0.0) {

    throw new IllegalStateException(
        "Invalid crusher rate/window length"
    );
}

while (crusherClockSec < endSec) {

    // 先确认此前实际完成积分的窗口已经结算。
    main.advanceCompletedGradeWindows(crusherClockSec);

    int w = main.currentWindowIndex;

    if (w < 0 || w >= 4) {
        throw new IllegalStateException(
            "Crusher cannot produce after all windows are closed"
        );
    }

    // 以当前统计窗口确定下一条边界。
    double boundarySec = (w + 1) * main.rlWindowSeconds;
    double stopSec = Math.min(endSec, boundarySec);

    if (stopSec <= crusherClockSec) {
        throw new IllegalStateException(
            "Crusher/window clock mismatch: clock="
            + crusherClockSec
            + " window=" + w
            + " boundary=" + boundarySec
        );
    }

    double processable = (stopSec - crusherClockSec) * rate;

    while (processable > 1e-9 && !crusherFifo.isEmpty()) {

        double[] batch = crusherFifo.peekFirst();

        if (batch == null || batch.length != 2
            || !Double.isFinite(batch[0]) || batch[0] <= 0.0
            || !Double.isFinite(batch[1])
            || batch[1] < 0.0 || batch[1] > 1.0) {

            throw new IllegalStateException(
                "Invalid crusher FIFO batch"
            );
        }

        double tons = Math.min(processable, batch[0]);

        // 这部分产出全部属于当前窗口。
        main.updateCrusherGrade(tons, batch[1]);

        batch[0] -= tons;
        crusherStoredTons -= tons;
        processable -= tons;

        if (batch[0] <= 1e-9) {
            crusherFifo.removeFirst();
        }
    }

    crusherStoredTons = Math.max(0.0, crusherStoredTons);

    // 必须先完成积分并更新破碎时钟，再结算窗口。
    crusherClockSec = stopSec;

    main.advanceCompletedGradeWindows(crusherClockSec);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792496943922</Id>
					<Name><![CDATA[auditBufferMetalTons]]></Name>
					<X>1030</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double metal = 0.0;
for (double[] batch : crusherFifo) {
    main.auditRequire(batch != null && batch.length == 2,
        "site=" + siteName + " invalid FIFO batch structure");
    main.auditRequire(Double.isFinite(batch[0]) && batch[0] >= 0.0
        && Double.isFinite(batch[1]) && batch[1] >= 0.0 && batch[1] <= 1.0,
        "site=" + siteName + " invalid FIFO tons/grade");
    metal += batch[0] * batch[1];
}
return metal;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792496968993</Id>
					<Name><![CDATA[auditDumpBalance]]></Name>
					<X>1030</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[where]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String p = where + " dump=" + siteName;
main.auditRequire(Double.isFinite(receivedTons) && receivedTons >= -1e-6,
    p + " invalid receivedTons");
main.auditRequire(Double.isFinite(receivedMetalTons) && receivedMetalTons >= -1e-6
    && receivedMetalTons <= receivedTons + 1e-6, p + " invalid receivedMetalTons");
if (!acceptsOre) {
    main.auditClose(p + " waste-metal=0", receivedMetalTons, 0.0);
    return;
}
main.auditRequire(siteId == 0, p + " audit assumes one crusher at siteId=0");
main.auditRequire(Double.isFinite(crusherStoredTons) && crusherStoredTons >= -1e-6,
    p + " invalid buffer B=" + crusherStoredTons);
main.auditRequire(Double.isFinite(crusherReservedTons) && crusherReservedTons >= -1e-6,
    p + " invalid reservation Q=" + crusherReservedTons);
main.auditRequire(Double.isFinite(crusherBufferCapacityTons)
    && crusherBufferCapacityTons > 0.0
    && crusherStoredTons + crusherReservedTons <= crusherBufferCapacityTons + 1e-6,
    p + " overflow B=" + crusherStoredTons + " Q=" + crusherReservedTons
    + " capacity=" + crusherBufferCapacityTons);

double fifoMetal = auditBufferMetalTons();
double fifoTons = 0.0;
for (double[] batch : crusherFifo) fifoTons += batch[0];
main.auditClose(p + " B=FIFO", crusherStoredTons, fifoTons);

double unloadingTons = 0.0;
for (Truck t : main.trucks) {
    if (t.isLoaded && t.payloadIsOre && t.targetDumpSiteId == siteId
        && "DUMPING".equals(t.executionPhase)) {
        main.auditRequire(Double.isFinite(t.dumpServiceStartTime)
            && t.dumpServiceStartTime * 60.0 < main.rlShiftSeconds,
            p + " ore unloading starts outside shift, truck=" + t.truckId);
        unloadingTons += t.payloadTons;
    }
}
main.auditClose(p + " Q=unloading-ore-trucks", crusherReservedTons, unloadingTons);
main.auditClose(p + " received=crushed+B",
    receivedTons, main.crusherOreTons + crusherStoredTons);
main.auditClose(p + " received-metal=crushed-metal+FIFO-metal",
    receivedMetalTons, main.crusherMetalTons + fifoMetal);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792499155398</Id>
					<Name><![CDATA[tryAdmitDumpTruck]]></Name>
					<X>740</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (dumpAdmissionPending
    || dumpCapacityWaitOrder.isEmpty()
    || main.episodeClosed
    || time(SECOND) >= main.rlShiftSeconds) {
    return;
}

Truck t = dumpCapacityWaitOrder.get(0);

if (t == null
    || !t.isLoaded
    || !Double.isFinite(t.payloadTons)
    || t.payloadTons <= 0.0) {

    throw new IllegalStateException(
        "Invalid truck waiting for dump capacity at " + siteName
    );
}

if (acceptsOre) {
    advanceCrusherTo(time(SECOND));

    // 容量不够：继续等，不释放车辆。
    if (!canAcceptCrusher(t)) {
        return;
    }
}

// 锁住下一次放行，直到这辆车在 delayDump 中完成预约。
dumpAdmissionPending = true;
obsAdmissionTruck = t;
dumpCapacityWaitOrder.remove(0);

if (!waitCrusherCapacity.free(t)) {
    throw new IllegalStateException(
        "waitCrusherCapacity failed to release truck="
        + t.truckId + " at " + siteName
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578540319</Id>
					<Name><![CDATA[obsMeanDumpMinutes]]></Name>
					<X>1340</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if(t==null || t.truckType<0 || t.truckType>2) throw new IllegalArgumentException("Invalid truck");
return acceptsOre ? (t.truckType==0?1.8:t.truckType==1?2.0:2.3)
                  : (t.truckType==0?1.5:t.truckType==1?1.7:2.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578560313</Id>
					<Name><![CDATA[appendDispatchObservation]]></Name>
					<X>1330</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[w]]></Name>
						<Type><![CDATA[DispatchObsWriter]]></Type>
					</Parameter>
					<Body><![CDATA[String p="dump."+siteId+".";
w.add(p+"available",available?1:0);
w.add(p+"acceptsOre",acceptsOre?1:0);
w.add(p+"capacity",serviceCapacity/3.0);
w.add(p+"occupied",dumpResource.busy()/3.0);
w.add(p+"dumping",numInDumpService/3.0);
w.add(p+"bufferTons",acceptsOre?crusherStoredTons/500.0:0.0);
w.add(p+"reservedTons",acceptsOre?crusherReservedTons/500.0:0.0);
w.add(p+"freeBufferTons",acceptsOre?(crusherBufferCapacityTons-crusherStoredTons-crusherReservedTons)/500.0:0.0);
w.add(p+"bufferCapacity",acceptsOre?crusherBufferCapacityTons/500.0:0.0);
w.add(p+"crusherRate",acceptsOre?crusherRateTph/2500.0:0.0);
w.add(p+"admissionPending",dumpAdmissionPending?1:0);
w.add(p+"admissionTruck",obsAdmissionTruck==null?0:(obsAdmissionTruck.truckId+1.0)/9.0);
java.util.ArrayList<Truck> q=new java.util.ArrayList<Truck>();
for(int i=0;i<queueDump.size();i++) q.add((Truck)queueDump.get(i));
w.truckSlots(p+"queue.",q);
q.clear();
for(int i=0;i<seizeDump.size();i++) q.add((Truck)seizeDump.get(i));
w.truckSlots(p+"seize.",q);
w.truckSlots(p+"capacityWait.",dumpCapacityWaitOrder);
q.clear();
for(int i=0;i<delayDump.size();i++) q.add((Truck)delayDump.get(i));
java.util.Collections.sort(q,(a,b)->Integer.compare(a.truckId,b.truckId));
w.truckSlots(p+"service.",q);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792578581325</Id>
					<Name><![CDATA[appendCrusherFifoObservation]]></Name>
					<X>1340</X><Y>190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[w]]></Name>
						<Type><![CDATA[DispatchObsWriter]]></Type>
					</Parameter>
					<Body><![CDATA[if(!acceptsOre || siteId!=0) throw new IllegalStateException("FIFO observation expects crusher 0");
if(crusherFifo.size()>16) throw new IllegalStateException("FIFO observation overflow; do not truncate batches");
int i=0;
double sum=0;
for(double[] b:crusherFifo) {
    if(b==null || b.length!=2 || b[0]<0 || b[1]<0 || b[1]>1)
        throw new IllegalStateException("Invalid FIFO batch");
    w.add("fifo."+i+".valid",1);
    w.add("fifo."+i+".tons",b[0]/500.0);
    w.add("fifo."+i+".grade",b[1]);
    sum+=b[0]; i++;
}
if(Math.abs(sum-crusherStoredTons)>1e-5) throw new IllegalStateException("FIFO observation mass mismatch");
for(;i<16;i++) {
    w.add("fifo."+i+".valid",0);
    w.add("fifo."+i+".tons",0);
    w.add("fifo."+i+".grade",0);
}]]></Body>
				</Function>
			</Functions>
