	<ActiveObjectClasses>
		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1776755236910</Id>
			<Name><![CDATA[Main]]></Name>
			<Import><![CDATA[import DRL.grpc.*;
import Fusion.grpc.StateData;
import Fusion.grpc.ObservationDict;
import Fusion.grpc.ActionDict;
import Fusion.grpc.StepResponse;
import io.grpc.Server;
import io.grpc.ServerBuilder;
import io.grpc.stub.StreamObserver;]]></Import>
			<StartupCode><![CDATA[if (!Double.isFinite(targetOreTonsShift)
    || targetOreTonsShift <= 0.0
    || !Double.isFinite(targetWasteTonsShift)
    || targetWasteTonsShift < 0.0
    || !Double.isFinite(wWasteShortfall)
    || wWasteShortfall < 0.0) {

    throw new IllegalStateException(
        "Invalid ore/waste reward parameters"
    );
}

traceln(
    "[REWARD_CONFIG] contract=" + rewardContractId
    + " gradeActionEnabled=" + enableGradeActionReward
    + " oreTarget=" + targetOreTonsShift
    + " wasteTarget=" + targetWasteTonsShift
    + " wasteWeight=" + wWasteShortfall
);
getEngine().setDefaultRandomGenerator(
    new java.util.Random(experimentSeed)
);

episodeId = rewardContractId
    + "-run-" + experimentRunIndex
    + "-seed-" + experimentSeed;
pendingClosedWindows.clear();

traceln(
    "[P0] contract=" + rewardContractId
    + " run_index=" + experimentRunIndex
    + " experiment_seed=" + experimentSeed
);
decisionSequence = 0;
episodeStarted = false;
episodeClosed = false;
previousAction = -1;

currentWindowIndex = 0;
windowOreTons = 0;
windowMetalTons = 0;

pendingGradeActionReward = 0;
pendingGrade2hReward = 0;
pendingGradeShiftReward = 0;
pendingProductionReward = 0;

enableDispatchFallback = false;
isWarmUp = false;
totalSystemLoadWaitTime = 0.0;
totalSystemDumpWaitTime = 0.0;
java.util.Arrays.fill(closedWindowOreTons, 0.0);
materialAuditReady = false;
materialAuditChecks = 0L;
java.util.Arrays.fill(closedWindowMetalTons, 0.0);
java.util.Arrays.fill(closedWindowGrades, 0.0);
java.util.Arrays.fill(closedWindowGradeGaps, 0.0);
init1();
initRoadPointNodeMap();
init_network();
init_routeNodeMap();
initDynamicSpeedModel();
obsInit();

if (enableOnnxDispatch) {
    rlClient = new RLClient(
        dispatchInferenceHost,
        dispatchInferencePort,
        dispatchInferenceTimeoutMs
    );
}
com.anylogic.engine.markup.Path[] roads = {
    path5, path2, path7, path8,
    path6, path, path1, path3
};

String[] roadNames = {
    "Crusher—intersection1",
    "intersection1—intersection2",
    "intersection2—intersection3",
    "intersection2—HG1",
    "intersection3—HG2",
    "intersection3—LG",
    "intersection2—WASTE",
    "intersection2—Dump"
};

traceln("===== 各路段长度 =====");

for (int i = 0; i < roads.length; i++) {
    traceln(String.format(
        java.util.Locale.US,
        "%s：%.3f px，%.3f m",
        roadNames[i],
        roads[i].length(),
        roads[i].length(METER)
    ));
}
auditRequire(Math.abs(rlShiftSeconds - 28800.0) <= 1e-9
    && Math.abs(rlWindowSeconds - 7200.0) <= 1e-9,
    "This audit configuration requires a 480 min shift and four 120 min windows");
auditRequire(warmUpTime == 0 && Math.abs(shiftDuration - 480.0) <= 1e-9,
    "This scenario uses warmUpTime=0 and shiftDuration=480 min");
auditClose("configured crusher capacity", getDumpSiteById(0).crusherBufferCapacityTons, 500.0);
materialAuditReady = true;
auditMaterialBalances("INITIAL");
for (Truck t : trucks) {
    t.deliver("ACTIVATE", t);
}
lastWaitVehicleSeconds = getCumulativeWaitVehicleSeconds();
lastDecisionTimeSec = time(SECOND);]]></StartupCode>
			<DestroyCode><![CDATA[if (rlClient != null) {
    rlClient.shutdown();
}
]]></DestroyCode>
