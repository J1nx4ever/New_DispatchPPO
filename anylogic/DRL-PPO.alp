				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776758742501</Id>
					<Name><![CDATA[updateCrusherGrade]]></Name>
					<X>440</X><Y>-390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[grade]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(tons) || tons <= 0.0 || !Double.isFinite(grade)
    || grade < 0.0 || grade > 1.0) {
    throw new IllegalArgumentException("Invalid crushed output");
}
crusherOreTons += tons;
crusherMetalTons += tons * grade;
windowOreTons += tons;
windowMetalTons += tons * grade;
totalProduction += tons;
currentFeedGrade = crusherMetalTons / crusherOreTons;
gradeGap = targetGrade - currentFeedGrade;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776758834191</Id>
					<Name><![CDATA[selectNextLoadSiteRandom]]></Name>
					<X>660</X><Y>-640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.ArrayList<Integer> candidates = new java.util.ArrayList<Integer>();
for (LoadSite s : loadSites) {
    if (s.getAvailableTons() > 1e-6) {
        candidates.add(s.siteId);
    }
}
if (candidates.isEmpty()) return -1;
return candidates.get(uniform_discr(0, candidates.size() - 1));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776758872990</Id>
					<Name><![CDATA[selectNextLoadSiteSQ]]></Name>
					<X>660</X><Y>-610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[int bestId = -1;
double bestScore = Double.POSITIVE_INFINITY;
for (LoadSite s : loadSites) {
    if (s.getAvailableTons() <= 1e-6) continue;
    double score = s.getQueueSize() + s.incomingTrucks + s.numInService;
    if (score < bestScore) {
        bestScore = score;
        bestId = s.siteId;
    }
}
return bestId;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776758908335</Id>
					<Name><![CDATA[selectNextLoadSiteGradeAware]]></Name>
					<X>660</X><Y>-580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[// 初始化最佳装载点和对应的最小车辆数
LoadSite bestPoint = null;
int minTrucks = Integer.MAX_VALUE;

// 1. 确定品位倾向：当前品位低则寻找高品位，当前品位高则寻找低品位
// 假设有一个基准品位 targetGrade，或者直接对比当前品位与装载点的品位关系
// 这里逻辑：如果当前偏低，我们倾向于找品位 > currentGrade 的；反之找 < currentGrade 的
boolean lookForHigher = currentFeedGrade < targetGrade; // targetGrade 需在模型中定义，例如标准品位

// 2. 第一轮筛选：严格满足品位方向
for (LoadSite lp : loadSites) {
    if (lp.getAvailableTons() <= 1e-6) continue;
    if (!lp.isOre) continue;
    boolean matchesGradeStrategy = lookForHigher ? (lp.grade > currentFeedGrade) : (lp.grade < currentFeedGrade);
    
    if (matchesGradeStrategy) {
        int totalTrucks = lp.getQueueSize() + lp.incomingTrucks + lp.numInService; // queue + incoming
        if (totalTrucks < minTrucks) {
            minTrucks = totalTrucks;
            bestPoint = lp;
        }
    }
}
return bestPoint == null ? selectNextLoadSiteSQ(t) : bestPoint.siteId;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776758939376</Id>
					<Name><![CDATA[selectNextLoadSite]]></Name>
					<X>660</X><Y>-550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[obsCheckDecision(t);
boolean any = false;
for (LoadSite s : loadSites) {
    if (s.getAvailableTons() > 1e-6) {
        any = true;
        break;
    }
}
if (!any) return -1;
int selected;
switch (currentDispatchPolicy) {
    case 0: selected = selectNextLoadSiteRandom(t); break;
    case 1: selected = selectNextLoadSiteSQ(t); break;
    case 2: selected = selectNextLoadSiteGradeAware(t); break;
    case 3: selected = selectNextLoadSiteAI(t); break;
    default: throw new IllegalStateException("Unknown policy: " + currentDispatchPolicy);
}
LoadSite s = selected < 0 ? null : getLoadSiteById(selected);
if (s == null || s.getAvailableTons() <= 1e-6) {
    throw new IllegalStateException("Dispatch selected unavailable material: " + selected);
}
return selected;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1776855555204</Id>
					<Name><![CDATA[P2L]]></Name>
					<X>660</X><Y>-520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[] P2LList =new  double[4];
double sum = 0;
double ave = 0;
for(int i = 0; i < collectionLoadSites.size(); i++){

	P2LList[i] = (DistanceRecorder(parking.getX(), parking.getY(),
	collectionLoadSites.get(i).getX(),collectionLoadSites.get(i).getY()));
	sum += P2LList[i];
}
ave = sum / 4;
traceln("P2L:" + ave);
return P2LList;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1776855571076</Id>
					<Name><![CDATA[P2D]]></Name>
					<X>660</X><Y>-490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[] P2DList = new double[2];
double sum = 0;
double ave = 0;
for (int i = 0 ; i < collectionDumpSites.size(); i++){
	P2DList[i] = DistanceRecorder(parking.getX(), parking.getY(),
	collectionDumpSites.get(i).getX(),collectionDumpSites.get(i).getY());
	sum += P2DList[i];
}
traceln("P2D" + ave);
return P2DList;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[][]]]></ReturnType>
					<Id>1776855589565</Id>
					<Name><![CDATA[L2D]]></Name>
					<X>660</X><Y>-460</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[][] L2DList = new double[2][4];


for (int i = 0; i < collectionDumpSites.size(); i++){
	for(int j = 0; j < collectionLoadSites.size(); j++){
		L2DList[i][j] = DistanceRecorder(collectionDumpSites.get(i).getX(),collectionDumpSites.get(i).getY(),
		collectionLoadSites.get(j).getX(),collectionLoadSites.get(j).getY());
		traceln(collectionDumpSites.get(i).getName() + "到" + collectionLoadSites.get(j).getName() 
		+ "的距离：" + L2DList[i][j]  + "m");
	}
}
return (L2DList);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Observation]]></ReturnType>
					<Id>1776929430864</Id>
					<Name><![CDATA[buildObservation]]></Name>
					<X>920</X><Y>-400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (usePhysicalObservation) return buildPhysicalObservation(t);
if (t == null) {
    throw new IllegalArgumentException("truck is required");
}

double fleet = trucks.size();
if (fleet <= 0 || targetOreTons2h <= 0 || targetOreTonsShift <= 0) {
    throw new IllegalStateException("Invalid observation denominator");
}

getDumpSiteById(0).advanceCrusherTo(time(SECOND));
advanceCompletedGradeWindows(time(SECOND));

double nowSec = Math.min(time(SECOND), rlShiftSeconds);

double grade2h =
    windowOreTons > 0
    ? windowMetalTons / windowOreTons
    : 0.0;

double gradeGap2hNorm =
    windowOreTons > 0
    ? clip((targetGrade - grade2h) / 0.15, -1.0, 1.0)
    : 0.0;

double gradeGapShiftNorm =
    crusherOreTons > 0
    ? clip((targetGrade - currentFeedGrade) / 0.15, -1.0, 1.0)
    : 0.0;

double windowStartSec =
    Math.min(currentWindowIndex, 3) * rlWindowSeconds;

double[] x = new double[31];

x[0] = gradeGap2hNorm;
x[1] = clip(windowOreTons / targetOreTons2h, 0.0, 1.0);
x[2] = clip(
    (nowSec - windowStartSec) / rlWindowSeconds,
    0.0,
    1.0
);

x[3] = gradeGapShiftNorm;
x[4] = clip(crusherOreTons / targetOreTonsShift, 0.0, 1.0);
x[5] = clip(nowSec / rlShiftSeconds, 0.0, 1.0);

// 必须按 siteId 0/1/2/3，而不是 population 当前遍历顺序
for (int siteId = 0; siteId < 4; siteId++) {
    LoadSite s = getLoadSiteById(siteId);
    if (s == null) {
        throw new IllegalStateException(
            "Missing LoadSite siteId=" + siteId
        );
    }

    int base = 6 + siteId * 3;
    x[base]     = clip(s.getQueueSize() / fleet, 0.0, 1.0);
    x[base + 1] = clip(s.incomingTrucks / fleet, 0.0, 1.0);
    x[base + 2] = s.getUtilization();
}

int crusherIncoming = 0;
int dumpIncoming = 0;

for (Truck other : trucks) {
    if (other.isLoaded && "TO_DUMP".equals(other.executionPhase)) {
        if (other.targetDumpSiteId == 0) crusherIncoming++;
        if (other.targetDumpSiteId == 1) dumpIncoming++;
    }
}

DumpSite crusher = getDumpSiteById(0);
DumpSite dump = getDumpSiteById(1);

x[18] = clip(crusher.getQueueSize() / fleet, 0.0, 1.0);
x[19] = clip(crusherIncoming / fleet, 0.0, 1.0);
x[20] = crusher.getUtilization();

x[21] = clip(dump.getQueueSize() / fleet, 0.0, 1.0);
x[22] = clip(dumpIncoming / fleet, 0.0, 1.0);
x[23] = dump.getUtilization();

// origin_initial, origin_crusher, origin_dump
x[24] = t.currentDumpSiteId < 0 ? 1.0 : 0.0;
x[25] = t.currentDumpSiteId == 0 ? 1.0 : 0.0;
x[26] = t.currentDumpSiteId == 1 ? 1.0 : 0.0;

// 装载点品位：严格按 siteId 0、1、2、3 排列。
// 与模型中的 grade 使用相同单位，例如 0.25，不能填成 25。
for (int siteId = 0; siteId < 4; siteId++) {
    LoadSite site = getLoadSiteById(siteId);

    if (site == null) {
        throw new IllegalStateException(
            "Missing LoadSite siteId=" + siteId
        );
    }

    double siteGrade = site.grade;

    if (!Double.isFinite(siteGrade)
        || siteGrade < 0.0
        || siteGrade > 1.0) {
        throw new IllegalStateException(
            "Invalid grade: siteId=" + siteId
            + ", grade=" + siteGrade
        );
    }

    x[27 + siteId] = siteGrade;
}
Observation.Builder builder = Observation.newBuilder()
    .setSchemaId("dispatch.v2-31");

for (int i = 0; i < x.length; i++) {
    if (!Double.isFinite(x[i])) {
        throw new IllegalStateException(
            "Non-finite observation[" + i + "]=" + x[i]
        );
    }
    builder.addValues((float) x[i]);
}

return builder.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
