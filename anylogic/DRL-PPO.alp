				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776760750866</Id>
					<Name><![CDATA[initDumpSite]]></Name>
					<X>490</X><Y>110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[id]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[name]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[oreFlag]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[wasteFlag]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[svcTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[siteId = id;
siteName = name;
acceptsOre = oreFlag;
acceptsWaste = wasteFlag;
serviceTime = svcTime;

available = true;
queueLen = 0;
busy = false;
receivedTons = 0.0;
receivedMetalTons = 0.0;
serviceCapacity = acceptsOre ? 3 : 2;
dumpResource.set_capacity(serviceCapacity);
delayDump.set_capacity(serviceCapacity);
dumpOccupied = new boolean[serviceCapacity];

numInDumpService = 0;
totalDumpQueueTime = 0;
totalDumpServiceTime = 0;
totalServed = 0;

crusherFifo.clear();
crusherStoredTons = 0.0;
crusherReservedTons = 0.0;
crusherClockSec = 0.0;
dumpCapacityWaitOrder.clear();
dumpAdmissionPending = false;
if (acceptsOre && (crusherBufferCapacityTons < 193.0 || crusherRateTph <= 0.0)) {
    throw new IllegalArgumentException("Invalid crusher configuration at " + siteName);
}
obsAdmissionTruck = null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776826839742</Id>
					<Name><![CDATA[getEmptySpotCount]]></Name>
					<X>490</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int count = 0;
for (boolean spot : dumpOccupied) {
    if (!spot) count++;
}
return count;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
